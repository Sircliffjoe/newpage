# NewPage Integrity Travels — Environment Variables
# Copy to .env for local testing or add to .kamal/secrets for production

# Rails master key (from config/master.key)
RAILS_MASTER_KEY=

# PostgreSQL (Production)
NEWPAGE_DATABASE_PASSWORD=
POSTGRES_PASSWORD=
DB_HOST=newpage-db

# Brevo Transactional Email API (https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=info@newpageintegritytravels.com
BREVO_SENDER_NAME=NewPage Integrity Travels
ADMIN_NOTIFICATION_EMAIL=newpageintegritytravels@gmail.com

# App Host & Analytics
APP_HOST=newpageintegritytravels.com
GOOGLE_ANALYTICS_ID=

# Kamal Registry (GitHub Container Registry or Docker Hub)
KAMAL_REGISTRY_USERNAME=
KAMAL_REGISTRY_PASSWORD=
