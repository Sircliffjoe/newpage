<% hero_bg = cms_image_url(@page&.hero_image, "https://images.unsplash.com/photo-1523050854058-8df90110c9f1?q=80&w=2070&auto=format&fit=crop") %>

<!-- Hero -->
<section class="relative py-24 bg-brand-blue-dark">
  <div class="absolute inset-0 z-0">
    <img src="<%= hero_bg %>" alt="Students graduating" class="w-full h-full object-cover opacity-25 mix-blend-overlay">
  </div>
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <span class="inline-block py-1 px-3 rounded-full bg-brand-red/20 text-brand-red-light border border-brand-red/30 text-xs font-semibold tracking-wider mb-5">INTERNATIONAL EDUCATION</span>
    <h1 class="font-heading text-4xl md:text-6xl font-bold text-white mb-6"><%= @page&.hero_title.presence || "Your Journey to a Global Degree" %></h1>
    <p class="text-xl text-blue-100 max-w-3xl mx-auto"><%= @page&.hero_subtitle.presence || "Academic counseling, overseas university admissions, scholarship guidance, and student visa processing for the UK, Canada, USA, Australia, Ireland & Europe." %></p>
  </div>
</section>

<!-- Dynamic Study Destinations -->
<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <h2 class="font-heading text-3xl font-bold text-brand-gray-900 mb-3">Top Study Destinations</h2>
      <p class="text-gray-500">Explore our partner countries and tuition guidance.</p>
    </div>

    <% if @study_destinations.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <% @study_destinations.each do |dest| %>
          <%= link_to destination_path(slug: dest.slug), class: "group relative rounded-2xl overflow-hidden h-64 shadow-md block bg-brand-blue-dark" do %>
            <% if dest.hero_image.attached? %>
              <%= image_tag dest.hero_image, class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" %>
            <% else %>
              <div class="w-full h-full bg-gradient-to-br from-brand-blue to-brand-red flex items-center justify-center">
                <span class="text-6xl"><%= flag_emoji(dest.country_code) %></span>
              </div>
            <% end %>
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent flex flex-col justify-end p-6">
              <h3 class="text-white font-heading font-bold text-xl"><%= dest.name %></h3>
              <% if dest.cost_estimate.present? %>
                <span class="text-xs text-brand-red-light font-semibold mt-1">From <%= dest.cost_estimate %></span>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        <% [
          { country: "United Kingdom", img: "https://images.unsplash.com/photo-1513635269975-59663e0ac1ad?q=80&w=800&auto=format&fit=crop" },
          { country: "Canada", img: "https://images.unsplash.com/photo-1503614472-8c93d56e92ce?q=80&w=800&auto=format&fit=crop" },
          { country: "United States", img: "https://images.unsplash.com/photo-1496442226666-8d4d0e62e6e9?q=80&w=800&auto=format&fit=crop" },
          { country: "Australia", img: "https://images.unsplash.com/photo-1523482580672-f109ba8cb9be?q=80&w=800&auto=format&fit=crop" }
        ].each do |dest| %>
          <div class="group relative rounded-2xl overflow-hidden h-64 shadow-md">
            <img src="<%= dest[:img] %>" alt="<%= dest[:country] %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex items-end p-6">
              <h3 class="text-white font-heading font-bold text-xl"><%= dest[:country] %></h3>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<!-- 4-Step Admission Process -->
<section class="py-20 bg-brand-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="font-heading text-3xl font-bold text-center text-brand-gray-900 mb-14">The Admission Process</h2>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <% [
        { num: "1", title: "Academic Counseling", desc: "We match your qualifications, budget, and career goals to accredited universities and scholarship options." },
        { num: "2", title: "Application & SOP", desc: "We prepare your transcripts, Statement of Purpose, references, and submit directly to partner schools." },
        { num: "3", title: "Offer & Tuition Deposit", desc: "Secure your conditional/unconditional offer letter, CAS/LOA, and transparent tuition deposit guidance." },
        { num: "4", title: "Student Visa & Arrival", desc: "Full student visa filing, interview prep, flight booking, and pre-departure orientation." }
      ].each do |step| %>
        <div class="bg-white rounded-2xl p-6 shadow-soft text-center">
          <div class="w-14 h-14 bg-brand-blue text-white rounded-full flex items-center justify-center font-heading font-bold text-xl mx-auto mb-5"><%= step[:num] %></div>
          <h4 class="font-heading font-bold text-lg text-brand-gray-900 mb-2"><%= step[:title] %></h4>
          <p class="text-sm text-gray-500 leading-relaxed"><%= step[:desc] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<% if @study_faqs.any? %>
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl font-bold text-brand-gray-900 mb-8 text-center">Study Abroad FAQs</h2>
      <div class="space-y-4">
        <% @study_faqs.each do |faq| %>
          <details class="bg-brand-gray-50 rounded-xl p-5">
            <summary class="font-semibold text-brand-gray-900 cursor-pointer"><%= faq.question %></summary>
            <p class="mt-3 text-sm text-gray-600 leading-relaxed"><%= faq.answer %></p>
          </details>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<!-- CTA -->
<section class="py-20 bg-brand-blue text-center">
  <div class="max-w-3xl mx-auto px-4">
    <h2 class="font-heading text-3xl font-bold text-white mb-4">Ready to Study Abroad?</h2>
    <p class="text-blue-100 mb-8">Send us your academic transcripts and preferred country — our education counselors will guide you every step of the way.</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <%= link_to "Begin Application", contact_path(subject: "Study Abroad Admission"), class: "bg-brand-red hover:bg-brand-red-light text-white font-bold py-4 px-10 rounded-full shadow-lg transition-colors" %>
      <a href="<%= whatsapp_link('Hello NewPage Integrity, I want to apply for Study Abroad.') %>" target="_blank" class="bg-white text-brand-blue font-bold py-4 px-8 rounded-full shadow-lg hover:bg-slate-100 transition-colors">Chat on WhatsApp</a>
    </div>
  </div>
</section>
