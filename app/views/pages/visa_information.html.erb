<% hero_bg = cms_image_url(@page&.hero_image, "https://images.unsplash.com/photo-1544161515-4ab6ce6db874?q=80&w=2070&auto=format&fit=crop") %>

<%= render layout: "shared/page_header", locals: {
  title: @page&.hero_title.presence || "Expert Visa Assistance",
  subtitle: @page&.hero_subtitle.presence || "We simplify tourist, student, work, and business visa applications across the UK, USA, Canada, Schengen Europe, UAE, Qatar, Oman, South Africa, and China.",
  eyebrow: "Visa & Immigration Consulting",
  bg_image: hero_bg,
  breadcrumbs: [["Home", root_path], ["Services", services_path], ["Visa Assistance", nil]]
} do %>
  <div class="flex flex-col sm:flex-row gap-3.5 justify-center">
    <%= link_to "Book Visa Consultation", contact_path(subject: "Visa Consultation"), class: "px-7 py-3.5 rounded-full bg-brand-red hover:bg-brand-red-light text-white font-semibold text-sm shadow-lg shadow-brand-red/30 hover:-translate-y-0.5 transition-all" %>
    <a href="<%= whatsapp_link('Hello NewPage Integrity, I need visa assistance.') %>" target="_blank" rel="noopener noreferrer" class="px-7 py-3.5 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold text-sm backdrop-blur-xs hover:-translate-y-0.5 transition-all">
      Chat on WhatsApp
    </a>
  </div>
<% end %>

<!-- Covered Destinations Strip (GSRAfrica-inspired) -->
<section class="py-10 bg-white border-b border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-center text-xs font-bold uppercase tracking-widest text-slate-400 mb-5">Direct Visa Processing &amp; Advisory Coverage</p>
    <div class="flex flex-wrap justify-center gap-3">
      <% ["🇬🇧 United Kingdom", "🇺🇸 United States", "🇨🇦 Canada", "🇪🇺 Schengen Europe", "🇦🇪 UAE / Dubai", "🇿🇦 South Africa", "🇨🇳 China", "🇦🇺 Australia", "🇮🇪 Ireland", "🇮🇳 India", "🇰🇪 Kenya"].each do |country| %>
        <span class="px-4 py-2 rounded-full bg-slate-50 border border-slate-200 text-sm font-medium text-slate-700"><%= country %></span>
      <% end %>
    </div>
  </div>
</section>

<!-- Visa Types & Dynamic Visa Services -->
<section class="py-20 bg-brand-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-14">
      <% [
        { title: "Tourist & Visit Visa", border: "border-brand-red", desc: "Complete document checklist, DS-160/Schengen/UK form preparation, itinerary support, and embassy interview coaching.", items: ["Document Audit & Review", "Application Form Filling", "Interview Coaching"] },
        { title: "Student & Study Permits", border: "border-brand-blue", desc: "End-to-end study permit processing including CAS/LOA verification, proof of funds guidance, and Statement of Purpose review.", items: ["Financial Proof Guidance", "SOP & Study Plan Review", "Pre-Departure Briefing"] },
        { title: "Business & Work Visas", border: "border-emerald-600", desc: "Tailored visa solutions for corporate executives, conference attendees, investors, and skilled professionals.", items: ["Invitation & Sponsorship Support", "Corporate Documentation", "Priority Appointment Guidance"] }
      ].each do |card| %>
        <div class="bg-white rounded-2xl shadow-soft p-8 border-t-4 <%= card[:border] %> hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
          <div>
            <h3 class="font-heading font-bold text-2xl text-brand-gray-900 mb-3"><%= card[:title] %></h3>
            <p class="text-gray-600 text-sm mb-6 leading-relaxed"><%= card[:desc] %></p>
            <ul class="space-y-2 text-gray-600 mb-8 text-sm">
              <% card[:items].each do |item| %>
                <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> <%= item %></li>
              <% end %>
            </ul>
          </div>
          <a href="#consultation" class="block w-full text-center bg-brand-gray-50 hover:bg-brand-blue hover:text-white text-brand-blue font-semibold py-3 rounded-xl transition-colors">Apply Now</a>
        </div>
      <% end %>
    </div>

    <% if @visa_services.any? %>
      <div class="mt-8">
        <h2 class="font-heading text-2xl font-bold text-brand-gray-900 mb-6 text-center">Specialized Visa Packages</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <% @visa_services.each do |service| %>
            <div class="bg-white rounded-2xl p-6 shadow-soft flex flex-col justify-between">
              <div>
                <h3 class="font-heading font-bold text-lg text-brand-gray-900 mb-2"><%= service.title %></h3>
                <p class="text-gray-500 text-sm mb-4"><%= service.short_description.presence || strip_tags(service.description.to_s).truncate(100) %></p>
              </div>
              <%= link_to "View Requirements →", service_path(slug: service.slug), class: "text-brand-blue font-semibold text-sm hover:text-brand-red" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>

<% if @visa_faqs.any? %>
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl font-bold text-brand-gray-900 mb-8 text-center">Visa Frequently Asked Questions</h2>
      <div class="space-y-4">
        <% @visa_faqs.each do |faq| %>
          <details class="bg-brand-gray-50 rounded-xl p-5">
            <summary class="font-semibold text-brand-gray-900 cursor-pointer"><%= faq.question %></summary>
            <p class="mt-3 text-sm text-gray-600 leading-relaxed"><%= faq.answer %></p>
          </details>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<!-- Consultation Form -->
<section id="consultation" class="py-20 bg-brand-gray-50">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-brand-blue-dark rounded-3xl shadow-2xl p-8 md:p-12">
      <div class="text-center mb-10">
        <h2 class="font-heading text-3xl font-bold text-white mb-4">Request a Visa Consultation</h2>
        <p class="text-blue-100">Fill out the form below and an immigration specialist will contact you within 24 hours.</p>
      </div>

      <%= form_with url: contacts_path, method: :post, class: "space-y-6" do %>
        <%= spam_protection_fields %>
        <%= hidden_field_tag "contact_submission[subject]", "Visa Consultation Request" %>
        <%= hidden_field_tag :service_type, "visa" %>
        <%= hidden_field_tag :source, "visa_page" %>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-medium text-blue-100 mb-2">Full Name</label>
            <input type="text" name="contact_submission[name]" required class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-3 text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-brand-red">
          </div>
          <div>
            <label class="block text-sm font-medium text-blue-100 mb-2">Email Address</label>
            <input type="email" name="contact_submission[email]" required class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-3 text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-brand-red">
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-blue-100 mb-2">Phone Number / WhatsApp</label>
          <input type="tel" name="contact_submission[phone]" required class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-3 text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-brand-red">
        </div>

        <div>
          <label class="block text-sm font-medium text-blue-100 mb-2">Visa Type &amp; Destination Country</label>
          <textarea name="contact_submission[message]" rows="4" required placeholder="E.g., I need a tourist visa to Canada or UK student visa..." class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-3 text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-brand-red"></textarea>
        </div>

        <button type="submit" class="w-full bg-brand-red hover:bg-brand-red-light text-white font-bold text-lg py-4 rounded-xl transition-colors shadow-lg cursor-pointer">
          Submit Visa Request
        </button>
      <% end %>
    </div>
  </div>
</section>
