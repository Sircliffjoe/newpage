<!-- Dynamic Featured Services (CMS-driven) -->
<% if @services.any? %>
  <section class="py-20 bg-brand-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-brand-red font-semibold text-sm uppercase tracking-wider">Featured Solutions</span>
          <h2 class="font-heading text-3xl md:text-4xl font-bold text-brand-gray-900 mt-2">Popular Services</h2>
        </div>
        <%= link_to "View All Services →", services_path, class: "text-brand-blue font-semibold hover:text-brand-red transition-colors" %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% @services.each do |service| %>
          <div class="bg-white rounded-2xl shadow-soft border border-slate-100 overflow-hidden group hover:-translate-y-1.5 hover:shadow-hover transition-all duration-300 flex flex-col">
            <div class="h-52 overflow-hidden bg-brand-blue-dark relative">
              <% if service.hero_image.attached? %>
                <%= image_tag service.hero_image, alt: service.title, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" %>
              <% else %>
                <img src="<%= service_fallbacks[service.category.to_s] || service_fallbacks['travel'] %>" alt="<%= service.title %>" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
              <% end %>
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
              <span class="absolute top-3 left-3 px-3 py-1 rounded-full text-xs font-semibold bg-white/95 text-brand-blue shadow-xs"><%= service.category.humanize %></span>
            </div>
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="font-heading font-bold text-xl text-brand-gray-900 mb-2 group-hover:text-brand-blue transition-colors"><%= service.title %></h3>
                <p class="text-slate-600 text-sm mb-4 line-clamp-3"><%= service.short_description.presence || strip_tags(service.description.to_s).truncate(110) %></p>
              </div>
              <%= link_to "View Details →", service_path(slug: service.slug), class: "text-brand-blue font-semibold text-sm hover:text-brand-red transition-colors" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<!-- Dynamic Top Destinations (CMS-driven) -->
