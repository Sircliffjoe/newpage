<% hero_bg = cms_image_url(@page&.hero_image, "https://images.unsplash.com/photo-1436491865332-7a61a109cc05?q=80&w=2074&auto=format&fit=crop") %>
<% feature_img = cms_image_url(@page&.section_image, "https://images.unsplash.com/photo-1573164713988-8665fc963095?q=80&w=2069&auto=format&fit=crop") %>

<!-- Hero Section -->
<section class="relative min-h-[88vh] flex items-center justify-center overflow-hidden bg-brand-blue-dark">
  <div class="absolute inset-0 z-0">
    <img src="<%= hero_bg %>" alt="NewPage Integrity Travels" class="w-full h-full object-cover opacity-40 mix-blend-overlay">
    <div class="absolute inset-0 bg-gradient-to-t from-brand-blue-dark via-brand-blue-dark/80 to-brand-blue-dark/40"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center py-20">
    <span class="inline-block py-1.5 px-4 rounded-full bg-brand-red/20 text-brand-red-light border border-brand-red/30 text-xs sm:text-sm font-semibold tracking-wider mb-6 backdrop-blur-sm">
      <%= @page&.setting("hero_badge", "NEWPAGE INTEGRITY TRAVELS & TOURS LIMITED") %>
    </span>
    <h1 class="font-heading text-4xl sm:text-5xl md:text-7xl font-bold text-white mb-6 leading-tight">
      <%= @page&.hero_title.presence || "Your Gateway to Global Opportunities" %>
    </h1>
    <p class="mt-4 text-lg md:text-2xl text-gray-300 max-w-3xl mx-auto font-light mb-10">
      <%= @page&.hero_subtitle.presence || "Trusted travel & tours, visa assistance, international university admissions, and CAC corporate registration — delivered with integrity." %>
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <%= link_to "Book Consultation", contact_path, class: "px-8 py-4 bg-brand-red hover:bg-brand-red-light text-white rounded-full font-semibold shadow-lg hover:-translate-y-0.5 transition-all" %>
      <%= link_to "Explore Services", services_path, class: "px-8 py-4 bg-white text-brand-blue-dark hover:bg-slate-100 rounded-full font-semibold shadow-lg hover:-translate-y-0.5 transition-all" %>
      <a href="<%= whatsapp_link('Hello NewPage Integrity, I would like to book a consultation.') %>" target="_blank" class="px-8 py-4 bg-white/15 backdrop-blur-md border border-white/25 text-white hover:bg-white/25 rounded-full font-semibold shadow-lg hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2">
        Chat on WhatsApp
      </a>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-none">
    <svg class="relative block w-full h-[50px] md:h-[90px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
      <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V120H0V95.8C59.71,118.08,130.83,115.93,198.71,105.7,243.68,98.92,286.7,78.5,321.39,56.44Z" class="fill-brand-gray-50"></path>
    </svg>
  </div>
</section>

<!-- Stats Strip -->
<section class="py-12 bg-brand-gray-50 relative z-20 -mt-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      <% [
        { val: @page&.setting("stat_years", "10+"), label: "Years Experience" },
        { val: @page&.setting("stat_visas", "5,000+"), label: "Visas & Admissions" },
        { val: @page&.setting("stat_destinations", "50+"), label: "Global Destinations" },
        { val: @page&.setting("stat_satisfaction", "99%"), label: "Client Satisfaction" }
      ].each do |stat| %>
        <div class="bg-white rounded-2xl p-6 shadow-soft text-center hover:-translate-y-1 transition-all duration-300">
          <div class="text-3xl sm:text-4xl font-heading font-bold text-brand-blue mb-1"><%= stat[:val] %></div>
          <div class="text-gray-500 text-sm font-medium"><%= stat[:label] %></div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<!-- 4 Core Practice Pillars -->
<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="text-brand-red font-semibold text-sm uppercase tracking-wider">What We Do</span>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-brand-gray-900 mt-2 mb-4">Four Pillars of Global Service</h2>
      <p class="text-gray-500 text-lg">End-to-end travel, visa, study abroad, and corporate registration consulting tailored to individuals, students, and businesses.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-7">
      <% [
        { title: "Travel & Tours", desc: "Domestic & international flights, hotel bookings, airport shuttles, travel insurance, and curated holiday packages.", path: services_path(category: "travel"), badge: "01" },
        { title: "Visa Assistance", desc: "Tourist, student, work, and business visa consulting for the UK, USA, Canada, Schengen, UAE, China & South Africa.", path: visa_information_path, badge: "02" },
        { title: "Study Abroad", desc: "Academic counseling, university admissions, scholarship guidance, and student visa processing worldwide.", path: study_abroad_path, badge: "03" },
        { title: "CAC & Corporate", desc: "Fast business name, LLC, NGO registration, SCUML, TIN, annual returns, and post-incorporation filings.", path: cac_services_path, badge: "04" }
      ].each do |pillar| %>
        <div class="group bg-brand-gray-50 rounded-2xl p-8 hover:bg-brand-blue transition-all duration-300 flex flex-col justify-between">
          <div>
            <span class="inline-block text-xs font-bold px-3 py-1 rounded-full bg-brand-blue/10 text-brand-blue group-hover:bg-white/20 group-hover:text-white mb-5"><%= pillar[:badge] %></span>
            <h3 class="font-heading text-xl font-bold text-brand-gray-900 mb-3 group-hover:text-white transition-colors"><%= pillar[:title] %></h3>
            <p class="text-gray-500 text-sm leading-relaxed mb-6 group-hover:text-blue-100 transition-colors"><%= pillar[:desc] %></p>
          </div>
          <%= link_to pillar[:path], class: "inline-flex items-center text-brand-blue font-semibold text-sm group-hover:text-white" do %>
            Explore <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>

<!-- Dynamic Featured Services (CMS-driven) -->
<% if @services.any? %>
  <section class="py-20 bg-brand-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-brand-red font-semibold text-sm uppercase tracking-wider">Featured Solutions</span>
          <h2 class="font-heading text-3xl md:text-4xl font-bold text-brand-gray-900 mt-2">Popular Services</h2>
        </div>
        <%= link_to "View All Services →", services_path, class: "text-brand-blue font-semibold hover:text-brand-red transition-colors" %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% @services.each do |service| %>
          <div class="bg-white rounded-2xl shadow-soft overflow-hidden group hover:-translate-y-1.5 transition-all duration-300 flex flex-col">
            <div class="h-48 overflow-hidden bg-brand-blue-dark relative">
              <% if service.hero_image.attached? %>
                <%= image_tag service.hero_image, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" %>
              <% else %>
                <div class="w-full h-full bg-gradient-to-br from-brand-blue to-brand-blue-dark flex items-center justify-center text-white/40 font-heading text-2xl font-bold px-6 text-center">
                  <%= service.category.humanize %>
                </div>
              <% end %>
              <span class="absolute top-3 left-3 px-3 py-1 rounded-full text-xs font-semibold bg-white/90 text-brand-blue"><%= service.category.humanize %></span>
            </div>
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="font-heading font-bold text-xl text-brand-gray-900 mb-2"><%= service.title %></h3>
                <p class="text-gray-500 text-sm mb-4 line-clamp-3"><%= service.short_description.presence || strip_tags(service.description.to_s).truncate(110) %></p>
              </div>
              <%= link_to "View Details →", service_path(slug: service.slug), class: "text-brand-blue font-semibold text-sm hover:text-brand-red transition-colors" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<!-- Dynamic Top Destinations (CMS-driven) -->
<% if @destinations.any? %>
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-brand-red font-semibold text-sm uppercase tracking-wider">Global Reach</span>
          <h2 class="font-heading text-3xl md:text-4xl font-bold text-brand-gray-900 mt-2">Top Travel &amp; Study Destinations</h2>
        </div>
        <%= link_to "Explore All Destinations →", destinations_path, class: "text-brand-blue font-semibold hover:text-brand-red transition-colors" %>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <% @destinations.each do |destination| %>
          <%= link_to destination_path(slug: destination.slug), class: "group relative rounded-2xl overflow-hidden h-72 shadow-md block bg-brand-blue-dark" do %>
            <% if destination.hero_image.attached? %>
              <%= image_tag destination.hero_image, class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" %>
            <% else %>
              <div class="w-full h-full bg-gradient-to-br from-brand-blue to-brand-red flex items-center justify-center">
                <span class="text-7xl"><%= flag_emoji(destination.country_code) %></span>
              </div>
            <% end %>
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent flex flex-col justify-end p-6">
              <span class="inline-block w-fit px-2.5 py-1 rounded-full text-[11px] font-semibold bg-white/20 backdrop-blur-xs text-white mb-2"><%= destination.category&.humanize %></span>
              <h3 class="text-white font-heading font-bold text-2xl"><%= flag_emoji(destination.country_code) %> <%= destination.name %></h3>
              <% if destination.cost_estimate.present? %>
                <p class="text-brand-red-light text-sm font-semibold mt-1">From <%= destination.cost_estimate %></p>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<!-- Why Choose Us -->
<section class="py-24 bg-brand-blue-dark text-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex flex-col lg:flex-row gap-14 items-center">
      <div class="lg:w-1/2">
        <span class="text-brand-red-light font-semibold tracking-wider text-sm uppercase mb-3 block">Why NewPage Integrity</span>
        <h2 class="font-heading text-3xl md:text-5xl font-bold mb-6">Excellence and Integrity in Every Journey</h2>
        <p class="text-gray-300 text-lg mb-8 leading-relaxed">
          From Warri to the world — we combine deep immigration expertise, transparent pricing, and personal consultant support so your travel, admission, or business registration succeeds without stress.
        </p>

        <div class="space-y-5">
          <% [
            { title: "High Approval Success Rate", desc: "Thorough document verification, SOP review, and mock embassy interviews." },
            { title: "Fast & Transparent Processing", desc: "Clear timelines and zero hidden fees across visa, admission, and CAC filings." },
            { title: "Dedicated Personal Consultant", desc: "One-on-one WhatsApp, phone, and in-office support from start to finish." }
          ].each do |item| %>
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-full bg-brand-red/25 flex items-center justify-center text-brand-red-light font-bold">✓</div>
              <div>
                <h4 class="font-heading font-bold text-lg"><%= item[:title] %></h4>
                <p class="text-gray-400 text-sm"><%= item[:desc] %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="lg:w-1/2 relative">
        <div class="absolute inset-0 bg-gradient-to-tr from-brand-red to-brand-blue rounded-2xl transform translate-x-3 translate-y-3 opacity-40"></div>
        <img src="<%= feature_img %>" alt="NewPage Integrity Consulting Team" class="relative z-10 rounded-2xl shadow-2xl w-full object-cover h-[440px]">
      </div>
    </div>
  </div>
</section>

<!-- Client Testimonials (CMS-driven) -->
<% if @testimonials.any? %>
  <section class="py-20 bg-brand-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-brand-red font-semibold text-sm uppercase tracking-wider">Client Stories</span>
          <h2 class="font-heading text-3xl md:text-4xl font-bold text-brand-gray-900 mt-2">Trusted by Thousands of Clients</h2>
        </div>
        <%= link_to "Read All Reviews →", testimonials_path, class: "text-brand-blue font-semibold hover:text-brand-red transition-colors" %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% @testimonials.each do |testimonial| %>
          <div class="bg-white rounded-2xl p-8 shadow-soft flex flex-col justify-between">
            <div>
              <div class="flex text-amber-400 mb-4 text-lg">
                <%= "★" * (testimonial.rating || 5) %>
              </div>
              <p class="text-gray-600 italic mb-6 leading-relaxed">"<%= testimonial.content %>"</p>
            </div>
            <div class="flex items-center gap-3 pt-4 border-t border-slate-100">
              <div class="w-11 h-11 rounded-full overflow-hidden bg-brand-blue/10 flex items-center justify-center font-bold text-brand-blue text-sm flex-shrink-0">
                <% if testimonial.image.attached? %>
                  <%= image_tag testimonial.image, class: "w-full h-full object-cover" %>
                <% else %>
                  <%= testimonial.client_name.to_s.first(2).upcase %>
                <% end %>
              </div>
              <div>
                <div class="font-heading font-bold text-brand-gray-900 text-sm"><%= testimonial.client_name %></div>
                <div class="text-xs text-gray-500"><%= testimonial.service_type&.humanize %></div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<!-- Latest Blog Insights (CMS-driven) -->
<% if @recent_posts.any? %>
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-brand-red font-semibold text-sm uppercase tracking-wider">News &amp; Guides</span>
          <h2 class="font-heading text-3xl md:text-4xl font-bold text-brand-gray-900 mt-2">Latest Travel &amp; Visa Updates</h2>
        </div>
        <%= link_to "Visit Blog →", blog_path, class: "text-brand-blue font-semibold hover:text-brand-red transition-colors" %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% @recent_posts.each do |post| %>
          <article class="bg-brand-gray-50 rounded-2xl overflow-hidden shadow-soft group flex flex-col">
            <div class="h-48 bg-brand-blue-dark overflow-hidden">
              <% if post.featured_image.attached? %>
                <%= image_tag post.featured_image, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" %>
              <% else %>
                <div class="w-full h-full bg-gradient-to-br from-brand-blue to-brand-blue-dark flex items-center justify-center text-white/40 font-heading font-bold text-lg">
                  <%= post.blog_category&.name %>
                </div>
              <% end %>
            </div>
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <span class="text-xs font-bold uppercase text-brand-red"><%= post.blog_category&.name %></span>
                <h3 class="font-heading font-bold text-lg text-brand-gray-900 mt-1 mb-2 group-hover:text-brand-blue transition-colors">
                  <%= link_to post.title, blog_post_path(slug: post.slug) %>
                </h3>
                <p class="text-gray-500 text-sm line-clamp-2"><%= post.excerpt %></p>
              </div>
              <div class="mt-4 pt-3 border-t border-slate-200/70 flex justify-between items-center text-xs text-gray-400">
                <span><%= (post.published_at || post.created_at).strftime("%b %d, %Y") %></span>
                <%= link_to "Read More →", blog_post_path(slug: post.slug), class: "text-brand-blue font-semibold" %>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<!-- Newsletter Signup (Wired to DB!) -->
<section class="py-20 bg-brand-blue text-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="font-heading text-3xl md:text-4xl font-bold mb-4">Stay Updated with Travel, Visa &amp; Scholarship Alerts</h2>
    <p class="text-blue-100 mb-8">Join our newsletter for embassy updates, flight deals, scholarship deadlines, and CAC compliance reminders.</p>

    <%= form_with url: newsletter_subscribers_path, method: :post, class: "flex flex-col sm:flex-row gap-3 max-w-2xl mx-auto" do %>
      <%= email_field_tag "newsletter_subscriber[email]", nil, required: true, placeholder: "Enter your email address",
            class: "flex-grow px-6 py-4 rounded-full bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-red shadow-sm" %>
      <%= submit_tag "Subscribe Now",
            class: "bg-brand-red hover:bg-brand-red-light text-white px-8 py-4 rounded-full font-semibold shadow-md transition-colors cursor-pointer whitespace-nowrap" %>
    <% end %>
  </div>
</section>
