              <%= link_to "Inquire", contact_path, class: "py-2.5 px-4 rounded-xl border border-slate-200 hover:border-brand-blue text-slate-700 hover:text-brand-blue text-xs font-semibold transition-colors" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

