<!-- Hero Section: Executive Full-Viewport Split Layout -->
<section class="relative min-h-[calc(100vh-5rem)] flex items-center overflow-hidden hero-animated-gradient text-white">
  <div class="absolute inset-0 z-0 pointer-events-none">
    <img src="<%= hero_bg %>" alt="Global aviation and travel" class="w-full h-full object-cover opacity-20 mix-blend-luminosity">
    <div class="absolute inset-0 hero-animated-gradient opacity-85"></div>
    <div class="absolute inset-0 hero-grid-overlay"></div>
    <div class="absolute -top-28 -right-24 w-[28rem] h-[28rem] bg-brand-red/25 rounded-full blur-3xl hero-orb-slow"></div>
    <div class="absolute -bottom-32 -left-24 w-[30rem] h-[30rem] bg-brand-blue-light/25 rounded-full blur-3xl hero-orb-reverse"></div>
  </div>

  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
      <!-- Left: Messaging & CTAs -->
      <div class="lg:col-span-7 text-left">
        <div class="inline-flex items-center gap-2 py-1.5 px-4 rounded-full bg-white/10 border border-white/15 text-xs sm:text-sm font-semibold tracking-wider text-blue-100 mb-6 backdrop-blur-sm">
          <%= @page&.setting("hero_badge", "WELCOME TO NEWPAGE INTEGRITY TRAVELS & TOURS LIMITED") %>
        </div>

        <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-[1.1] tracking-tight mb-6">
          <%= @page&.hero_title.presence || "Your Trusted Gateway to Global Travel, Visas & Corporate Success" %>
        </h1>

        <p class="text-base sm:text-lg lg:text-xl text-slate-300 max-w-2xl leading-relaxed mb-9">
          <%= @page&.hero_subtitle.presence || "Seamless flight ticketing, high-approval visa & residency consulting, international university admissions, and accredited CAC business registration — delivered with integrity." %>
        </p>

        <div class="flex flex-col sm:flex-row flex-wrap gap-3.5 mb-10">
          <%= link_to contact_path, class: "inline-flex items-center justify-center gap-2 px-7 py-4 bg-brand-red hover:bg-brand-red-light text-white rounded-full font-semibold text-sm sm:text-base shadow-lg shadow-brand-red/30 hover:-translate-y-0.5 transition-all" do %>
            Book Consultation
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          <% end %>

          <a href="<%= whatsapp_link('Hello NewPage Integrity Travels, I would like to make an inquiry.') %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-emerald-600 hover:bg-emerald-500 text-white rounded-full font-semibold text-sm sm:text-base shadow-lg hover:-translate-y-0.5 transition-all">
            Chat on WhatsApp
          </a>

          <%= link_to "Explore Services", services_path, class: "inline-flex items-center justify-center px-7 py-4 bg-white/10 hover:bg-white/20 border border-white/20 text-white rounded-full font-semibold text-sm sm:text-base backdrop-blur-xs hover:-translate-y-0.5 transition-all" %>
        </div>

        <!-- Inline Trust Metrics -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 border-t border-white/15">
          <% [
            { val: @page&.setting("stat_years", "10+"), label: "Years Experience" },
            { val: @page&.setting("stat_visas", "5,000+"), label: "Visas & Admissions" },
            { val: @page&.setting("stat_destinations", "50+"), label: "Global Destinations" },
            { val: @page&.setting("stat_satisfaction", "99%"), label: "Client Satisfaction" }
          ].each do |stat| %>
            <div>
              <div class="text-2xl sm:text-3xl font-heading font-extrabold text-white"><%= stat[:val] %></div>
              <div class="text-xs text-slate-300 mt-0.5"><%= stat[:label] %></div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Right: Visual Collage Showcase -->
      <div class="lg:col-span-5">
        <div class="relative grid grid-cols-2 gap-4">
          <div class="col-span-2 relative rounded-2xl overflow-hidden shadow-2xl border border-white/15 group h-64 sm:h-72 lg:h-80">
            <%= image_tag "home/qatar-residence.jpg", alt: "Qatar Residence Permit & Visa Consulting", class: "w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" %>
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent flex items-end p-4">
              <div class="flex items-center justify-between w-full">
                <span class="text-white font-heading font-bold text-sm sm:text-base">Qatar Residence &amp; Work Pathways</span>
                <span class="px-2.5 py-1 rounded-full bg-brand-red text-white text-[11px] font-bold">Hot Offer</span>
              </div>
            </div>
          </div>

          <div class="relative rounded-2xl overflow-hidden shadow-xl border border-white/15 group h-48 sm:h-52 lg:h-56">
            <%= image_tag "home/oman-residence.jpg", alt: "Oman Residence Processing", class: "w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" %>
            <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent flex items-end p-3.5">
              <span class="text-white font-heading font-bold text-xs sm:text-sm">Oman Residence</span>
            </div>
          </div>

          <div class="relative rounded-2xl overflow-hidden shadow-xl border border-white/15 group h-48 sm:h-52 lg:h-56">
            <%= image_tag "home/uganda-visa.jpg", alt: "Uganda Visa & Tours", class: "w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500" %>
            <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent flex items-end p-3.5">
              <span class="text-white font-heading font-bold text-xs sm:text-sm">Uganda Visa &amp; Tours</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Trending Visa & Residency Programs (Featuring Uploaded Campaign Visuals) -->
<section class="py-20 bg-brand-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
