        <% @destinations.each do |destination| %>
          <%= link_to destination_path(slug: destination.slug), class: "group relative rounded-2xl overflow-hidden h-72 shadow-md hover:shadow-xl block bg-brand-blue-dark transition-shadow" do %>
            <% if destination.hero_image.attached? %>
              <%= image_tag destination.hero_image, alt: destination.name, class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" %>
            <% else %>
              <img src="<%= destination_fallbacks[destination.country_code.to_s.upcase] || 'https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?q=80&w=1200&auto=format&fit=crop' %>" alt="<%= destination.name %>" loading="lazy" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
            <% end %>
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent flex flex-col justify-end p-6">
              <span class="inline-block w-fit px-2.5 py-1 rounded-full text-[11px] font-semibold bg-white/20 backdrop-blur-xs text-white mb-2"><%= destination.category&.humanize %></span>
              <h3 class="text-white font-heading font-bold text-2xl"><%= flag_emoji(destination.country_code) %> <%= destination.name %></h3>
              <% if destination.cost_estimate.present? %>
                <p class="text-brand-red-light text-sm font-semibold mt-1">From <%= destination.cost_estimate %></p>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<!-- Why Choose Us -->
<section class="py-24 bg-brand-blue-dark text-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-6">
        <span class="text-brand-red-light font-semibold tracking-wider text-sm uppercase mb-3 block">Why NewPage Integrity</span>
        <h2 class="font-heading text-3xl md:text-5xl font-bold mb-6 leading-tight">Excellence and Integrity in Every Journey</h2>
        <p class="text-slate-300 text-lg mb-8 leading-relaxed">
          From Warri to the world — we combine deep immigration expertise, transparent pricing, and personal consultant support so your travel, admission, or business registration succeeds without stress.
        </p>

        <div class="space-y-5">
          <% [
            { title: "High Approval Success Rate", desc: "Thorough document verification, SOP review, and embassy interview preparation." },
            { title: "Fast & Transparent Processing", desc: "Clear timelines and zero hidden fees across visa, admission, and CAC filings." },
            { title: "Dedicated Personal Consultant", desc: "One-on-one WhatsApp, phone, and in-office support from inquiry to completion." }
          ].each do |item| %>
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-full bg-brand-red/25 border border-brand-red/40 flex items-center justify-center text-brand-red-light font-bold">✓</div>
              <div>
                <h4 class="font-heading font-bold text-lg"><%= item[:title] %></h4>
                <p class="text-slate-400 text-sm"><%= item[:desc] %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="lg:col-span-6 relative">
        <div class="absolute inset-0 bg-gradient-to-tr from-brand-red to-brand-blue-light rounded-3xl transform translate-x-3 translate-y-3 opacity-35"></div>
        <img src="<%= feature_img %>" alt="NewPage Integrity Consulting Team" loading="lazy" class="relative z-10 rounded-3xl shadow-2xl w-full object-cover h-[440px]">
        <div class="relative z-20 -mt-12 mx-4 sm:mx-6 bg-white text-slate-900 rounded-2xl p-5 shadow-xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-brand-red">Warri Head Office</div>
            <div class="font-heading font-bold text-sm sm:text-base text-brand-blue-dark">Top Floor, No. 4 Airport Road, Opp. Kosini Junction, Warri</div>
          </div>
          <%= link_to "Visit Us", contact_path, class: "px-5 py-2.5 rounded-full bg-brand-blue text-white text-xs font-semibold hover:bg-brand-blue-dark transition-colors whitespace-nowrap" %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Awards & Industry Recognition (CMS-driven) -->
<% if @awards&.any? %>
  <section class="py-20 bg-white border-t border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div class="max-w-2xl">
          <span class="text-brand-red font-semibold text-sm uppercase tracking-wider">Award-Winning Excellence</span>
          <h2 class="font-heading text-3xl md:text-4xl font-bold text-brand-gray-900 mt-2">Recognized Across the Industry</h2>
          <p class="text-slate-600 mt-2">Honours earned by NewPage Integrity Travels &amp; Tours Limited and our Founder &amp; CEO, Mrs. Ify Adegoke.</p>
        </div>
        <%= link_to "View All Awards →", awards_path, class: "text-brand-blue font-semibold hover:text-brand-red transition-colors whitespace-nowrap" %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <% @awards.each do |award| %>
          <div class="bg-brand-gray-50 rounded-3xl border border-slate-200/80 shadow-soft overflow-hidden flex flex-col sm:flex-row group hover:-translate-y-1 hover:shadow-hover transition-all duration-300">
            <% if award.image.attached? %>
              <div class="sm:w-52 flex-shrink-0 bg-slate-900 overflow-hidden">
                <%= image_tag award.image, alt: award.title, loading: "lazy", class: "w-full h-56 sm:h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" %>
              </div>
            <% end %>
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold <%= award.founder? ? 'bg-amber-100 text-amber-800' : 'bg-brand-blue/10 text-brand-blue' %>">
                    <%= award.recipient_label %>
                  </span>
                  <% if award.award_year.present? %>
                    <span class="text-xs font-semibold text-slate-400"><%= award.award_year %></span>
                  <% end %>
                </div>
                <h3 class="font-heading text-xl font-bold text-brand-gray-900 mb-1.5"><%= award.title %></h3>
                <p class="text-xs font-semibold text-brand-red mb-2"><%= award.issuing_organization %></p>
                <p class="text-slate-600 text-sm line-clamp-3 leading-relaxed"><%= award.description %></p>
              </div>
              <div class="mt-4 pt-3 border-t border-slate-200/70">
                <%= link_to "See Recognition Details →", awards_path, class: "text-brand-blue font-semibold text-xs hover:text-brand-red transition-colors" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<!-- Client Testimonials (CMS-driven) -->
<% if @testimonials.any? %>
  <section class="py-20 bg-brand-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-brand-red font-semibold text-sm uppercase tracking-wider">Client Stories</span>
          <h2 class="font-heading text-3xl md:text-4xl font-bold text-brand-gray-900 mt-2">Trusted by Thousands of Clients</h2>
        </div>
        <%= link_to "Read All Reviews →", testimonials_path, class: "text-brand-blue font-semibold hover:text-brand-red transition-colors" %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% @testimonials.each do |testimonial| %>
          <div class="bg-white rounded-2xl p-8 shadow-soft border border-slate-100 flex flex-col justify-between">
            <div>
              <div class="flex text-amber-400 mb-4 text-lg">
                <%= "★" * (testimonial.rating || 5) %>
              </div>
              <p class="text-slate-600 italic mb-6 leading-relaxed">"<%= testimonial.content %>"</p>
            </div>
            <div class="flex items-center gap-3 pt-4 border-t border-slate-100">
              <div class="w-11 h-11 rounded-full overflow-hidden bg-brand-blue/10 flex items-center justify-center font-bold text-brand-blue text-sm flex-shrink-0">
                <% if testimonial.image.attached? %>
                  <%= image_tag testimonial.image, alt: testimonial.client_name, class: "w-full h-full object-cover" %>
                <% else %>
                  <%= testimonial.client_name.to_s.first(2).upcase %>
                <% end %>
              </div>
              <div>
                <div class="font-heading font-bold text-brand-gray-900 text-sm"><%= testimonial.client_name %></div>
                <div class="text-xs text-slate-500"><%= testimonial.service_type&.humanize %></div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<!-- Latest Blog Insights (CMS-driven) -->
<% if @recent_posts.any? %>
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-brand-red font-semibold text-sm uppercase tracking-wider">News &amp; Guides</span>
          <h2 class="font-heading text-3xl md:text-4xl font-bold text-brand-gray-900 mt-2">Latest Travel &amp; Visa Updates</h2>
        </div>
        <%= link_to "Visit Blog →", blog_path, class: "text-brand-blue font-semibold hover:text-brand-red transition-colors" %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% @recent_posts.each do |post| %>
          <article class="bg-brand-gray-50 rounded-2xl overflow-hidden shadow-soft border border-slate-100 group flex flex-col">
            <div class="h-48 bg-brand-blue-dark overflow-hidden">
              <% if post.featured_image.attached? %>
                <%= image_tag post.featured_image, alt: post.title, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" %>
              <% else %>
                <img src="https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?q=80&w=1000&auto=format&fit=crop" alt="<%= post.title %>" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
              <% end %>
            </div>
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <span class="text-xs font-bold uppercase text-brand-red"><%= post.blog_category&.name %></span>
                <h3 class="font-heading font-bold text-lg text-brand-gray-900 mt-1 mb-2 group-hover:text-brand-blue transition-colors">
                  <%= link_to post.title, blog_post_path(slug: post.slug) %>
                </h3>
                <p class="text-slate-600 text-sm line-clamp-2"><%= post.excerpt %></p>
              </div>
              <div class="mt-4 pt-3 border-t border-slate-200/70 flex justify-between items-center text-xs text-slate-400">
                <span><%= (post.published_at || post.created_at).strftime("%b %d, %Y") %></span>
                <%= link_to "Read More →", blog_post_path(slug: post.slug), class: "text-brand-blue font-semibold" %>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

