<% hero_bg = cms_image_url(@page&.hero_image, "https://images.unsplash.com/photo-1556761175-5973dc0f32b7?q=80&w=2061&auto=format&fit=crop") %>

<%= render layout: "shared/page_header", locals: {
  title: @page&.hero_title.presence || "CAC & Corporate Registrations",
  subtitle: @page&.hero_subtitle.presence || "Formalize your business in Nigeria with ease. Business Names, Limited Liability Companies, NGOs, SCUML, TIN, and Annual Returns handled seamlessly.",
  eyebrow: "Corporate Affairs & Compliance",
  bg_image: hero_bg,
  breadcrumbs: [["Home", root_path], ["Services", services_path], ["CAC Registration", nil]]
} do %>
  <div class="flex flex-col sm:flex-row gap-3.5 justify-center">
    <%= link_to "Register Your Business", contact_path(subject: "CAC Business Registration"), class: "px-7 py-3.5 rounded-full bg-brand-red hover:bg-brand-red-light text-white font-semibold text-sm shadow-lg shadow-brand-red/30 hover:-translate-y-0.5 transition-all" %>
    <a href="<%= whatsapp_link('Hello NewPage Integrity, I need help with CAC registration.') %>" target="_blank" rel="noopener noreferrer" class="px-7 py-3.5 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold text-sm backdrop-blur-xs hover:-translate-y-0.5 transition-all">
      Chat on WhatsApp
    </a>
  </div>
<% end %>

<!-- Services Grid -->
<section class="py-20 bg-brand-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <% if @cac_services.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @cac_services.each do |service| %>
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow flex flex-col justify-between">
            <div>
              <h3 class="font-heading font-bold text-xl text-brand-gray-900 mb-3"><%= service.title %></h3>
              <p class="text-gray-500 text-sm mb-6 leading-relaxed"><%= service.short_description.presence || strip_tags(service.description.to_s).truncate(130) %></p>
            </div>
            <div class="flex items-center justify-between pt-4 border-t border-slate-100">
              <%= link_to "View Details →", service_path(slug: service.slug), class: "text-brand-blue font-semibold text-sm hover:underline" %>
              <%= link_to "Request", contact_path(subject: service.title), class: "text-brand-red font-semibold text-sm hover:underline" %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% [
          { title: "Business Name Registration", desc: "Perfect for sole proprietors and partnerships. Get your BN certificate and TIN within 7-10 working days." },
          { title: "Limited Liability Company (LLC)", desc: "Incorporate your company (Ltd) with MemArt, status report, certificate of incorporation, and TIN." },
          { title: "NGO & Incorporated Trustees", desc: "Register your Non-Governmental Organization, Church, Mosque, Club, or Foundation cleanly." },
          { title: "Post-Incorporation Services", desc: "Change of directors, change of name, share capital increase, company upgrade, and CTC documents." },
          { title: "Annual Returns Filing", desc: "Avoid CAC penalties and keep your company status active with accurate, timely annual returns." },
          { title: "SCUML & Tax Clearance", desc: "Obtain your EFCC SCUML certificate, FIRS Tax Identification Number, and Tax Clearance Certificate." }
        ].each do |service| %>
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
            <h3 class="font-heading font-bold text-xl text-brand-gray-900 mb-3"><%= service[:title] %></h3>
            <p class="text-gray-500 text-sm mb-6"><%= service[:desc] %></p>
            <%= link_to "Request Service →", contact_path(subject: service[:title]), class: "text-brand-red font-semibold text-sm hover:underline" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<!-- Why Register + WhatsApp CTA -->
<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center gap-12">
    <div class="md:w-1/2">
      <h2 class="font-heading text-3xl font-bold text-brand-gray-900 mb-6">Why Register Your Business?</h2>
      <ul class="space-y-4">
        <li class="flex items-start gap-3">
          <span class="mt-0.5 w-6 h-6 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-xs font-bold flex-shrink-0">✓</span>
          <div><strong class="text-gray-900 block">Corporate Credibility</strong><span class="text-gray-500 text-sm">Build trust with clients, embassies, and corporate partners who deal only with registered entities.</span></div>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-0.5 w-6 h-6 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-xs font-bold flex-shrink-0">✓</span>
          <div><strong class="text-gray-900 block">Corporate Bank Account</strong><span class="text-gray-500 text-sm">Open a dedicated business bank account and receive payments under your brand name.</span></div>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-0.5 w-6 h-6 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-xs font-bold flex-shrink-0">✓</span>
          <div><strong class="text-gray-900 block">Contracts, Loans &amp; Grants</strong><span class="text-gray-500 text-sm">Qualify for government tenders, SME grants, and corporate contracts across Nigeria.</span></div>
        </li>
      </ul>
    </div>
    <div class="md:w-1/2">
      <div class="bg-brand-blue text-white p-8 rounded-3xl shadow-xl">
        <h3 class="font-heading text-2xl font-bold mb-4">Need Expedited CAC Filing?</h3>
        <p class="mb-6 text-blue-100">Send us your two proposed business names on WhatsApp for an instant availability check and quote.</p>
        <a href="<%= whatsapp_link('Hello NewPage Integrity, I want to register a business with CAC.') %>" target="_blank" class="block w-full text-center bg-white text-brand-blue font-bold py-4 rounded-xl hover:bg-slate-100 transition-colors">Chat with CAC Specialist</a>
      </div>
    </div>
  </div>
</section>
