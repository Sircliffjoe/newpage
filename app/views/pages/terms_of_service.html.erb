<%= render "shared/page_header",
  title: "Terms of Service",
  subtitle: "Effective Date: #{Time.current.strftime('%B %Y')}",
  eyebrow: "Legal & Compliance",
  compact: true,
  breadcrumbs: [["Home", root_path], ["Terms of Service", nil]] %>

<section class="py-16 bg-white">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 prose max-w-none">
    <% if @page&.rich_content&.present? %>
      <%= @page.rich_content %>
    <% else %>
      <p>By accessing <strong>newpageintegritytravels.com</strong> or engaging NewPage Integrity Travels &amp; Tours Limited for travel, visa, study abroad, or corporate registration services, you agree to these terms.</p>
      <h2>Advisory &amp; Processing</h2>
      <p>We provide professional documentation review, application support, and travel advisory. Final visa and admission decisions rest solely with the respective embassies, immigration authorities, and academic institutions.</p>
      <h2>Client Responsibilities</h2>
      <p>Clients are responsible for providing accurate, truthful, and complete documentation for all travel, visa, admission, and CAC filings.</p>
    <% end %>
  </div>
</section>
