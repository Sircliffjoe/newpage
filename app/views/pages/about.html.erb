<% hero_bg = cms_image_url(@page&.hero_image, "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?q=80&w=2070&auto=format&fit=crop") %>
<% story_img = cms_image_url(@page&.section_image, "https://images.unsplash.com/photo-1552664730-d307ca884978?q=80&w=2070&auto=format&fit=crop") %>

<%= render "shared/page_header",
  title: @page&.hero_title.presence || "About NewPage Integrity",
  subtitle: @page&.hero_subtitle.presence || "Your trusted partner in navigating global travel, study abroad, visa, and corporate opportunities with excellence and transparency.",
  eyebrow: "Who We Are",
  bg_image: hero_bg,
  breadcrumbs: [["Home", root_path], ["About Us", nil]] %>

<!-- Company Story & Mission -->
<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <div>
        <h2 class="font-heading text-3xl font-bold text-brand-gray-900 mb-6">Our Story</h2>
        <% if @page&.rich_content&.present? %>
          <div class="prose max-w-none text-gray-600 mb-8"><%= @page.rich_content %></div>
        <% else %>
          <p class="text-gray-600 mb-6 leading-relaxed">
            Founded with a vision to simplify international travel, overseas education, and corporate business processes, <strong>NewPage Integrity Travels &amp; Tours Limited</strong> has grown into a trusted consulting agency serving Warri, Delta State, Nigeria, and clients worldwide.
          </p>
          <p class="text-gray-600 mb-8 leading-relaxed">
            We combine ethical guidance, up-to-date embassy requirements, university partnerships, and Corporate Affairs Commission expertise to deliver stress-free results.
          </p>
        <% end %>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="bg-brand-gray-50 p-6 rounded-xl border-l-4 border-brand-blue">
            <h3 class="font-heading font-bold text-xl text-brand-gray-900 mb-2">Our Mission</h3>
            <p class="text-gray-600 text-sm">To provide seamless, reliable, and transparent travel, educational, and corporate services that empower our clients to achieve their global aspirations.</p>
          </div>
          <div class="bg-brand-gray-50 p-6 rounded-xl border-l-4 border-brand-red">
            <h3 class="font-heading font-bold text-xl text-brand-gray-900 mb-2">Our Vision</h3>
            <p class="text-gray-600 text-sm">To be the most trusted and preferred consulting agency in Africa for travel, immigration, and business solutions.</p>
          </div>
        </div>
      </div>

      <div class="relative">
        <div class="absolute inset-0 bg-brand-blue transform translate-x-4 translate-y-4 rounded-2xl opacity-10"></div>
        <img src="<%= story_img %>" alt="NewPage Integrity Office" class="relative rounded-2xl shadow-xl w-full object-cover h-[420px]">
      </div>
    </div>
  </div>
</section>

<!-- Core Values -->
<section class="py-20 bg-brand-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <h2 class="font-heading text-3xl font-bold text-brand-gray-900 mb-4">Our Core Values</h2>
      <p class="text-gray-500">The principles that guide every consultation, application, and itinerary.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <% [
        { title: "Integrity", desc: "It's in our name. We operate with complete honesty, transparency, and ethical standards in all client dealings." },
        { title: "Excellence", desc: "We stay ahead of embassy policies, university requirements, and corporate regulations to deliver top outcomes." },
        { title: "Client-Centric", desc: "Every client gets personalized attention, clear communication, and dedicated support from inquiry to arrival." }
      ].each do |val| %>
        <div class="bg-white p-8 rounded-2xl shadow-soft text-center">
          <h3 class="font-heading font-bold text-xl text-brand-gray-900 mb-3"><%= val[:title] %></h3>
          <p class="text-gray-500 text-sm leading-relaxed"><%= val[:desc] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<!-- Founder & CEO Spotlight -->
<% if @founder.present? %>
  <section class="py-20 bg-slate-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-white/15 bg-slate-800">
            <% if @founder.image.attached? %>
              <%= image_tag @founder.image, alt: @founder.name, class: "w-full h-[460px] object-cover object-top" %>
            <% else %>
              <div class="w-full h-[420px] flex items-center justify-center bg-brand-blue text-5xl font-heading font-bold">
                <%= @founder.name.split.map(&:first).join.first(2).upcase %>
              </div>
            <% end %>
            <div class="absolute bottom-4 left-4 right-4 bg-black/70 backdrop-blur-sm rounded-2xl p-4 border border-white/10">
              <div class="text-xs font-bold uppercase tracking-wider text-amber-400">Founder &amp; Chief Executive Officer</div>
              <div class="font-heading font-bold text-lg text-white"><%= @founder.name %></div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <span class="text-brand-red-light font-semibold text-sm uppercase tracking-wider">Leadership</span>
          <h2 class="font-heading text-3xl md:text-4xl font-bold mt-2 mb-5">Meet Our Founder — Mrs. Ify Adegoke</h2>
          <p class="text-slate-300 text-base leading-relaxed mb-6">
            <%= @founder.bio %>
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
            <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
              <div class="text-amber-400 font-bold text-xs uppercase tracking-wider mb-1">Leadership Fellowship</div>
              <div class="font-heading font-bold text-white text-base">Fellow, African Institute of Public Leadership (FAIPL)</div>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
              <div class="text-brand-red-light font-bold text-xs uppercase tracking-wider mb-1">Industry Leadership</div>
              <div class="font-heading font-bold text-white text-base">NANTA Eastern Zone Travel Agency of the Year</div>
            </div>
          </div>
          <%= link_to "View Awards & Recognition →", awards_path, class: "inline-flex items-center px-6 py-3 rounded-full bg-brand-red hover:bg-brand-red-light text-white text-sm font-semibold transition-colors" %>
        </div>
      </div>
    </div>
  </section>
<% end %>

<!-- Awards & Achievements Preview -->
<% if @awards&.any? %>
  <section class="py-20 bg-brand-gray-50 border-t border-slate-200/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-brand-red font-semibold text-sm uppercase tracking-wider">Milestones &amp; Honours</span>
          <h2 class="font-heading text-3xl font-bold text-brand-gray-900 mt-2">Awards &amp; Recognition</h2>
        </div>
        <%= link_to "Explore All Awards →", awards_path, class: "text-brand-blue font-semibold hover:text-brand-red transition-colors" %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <% @awards.each do |award| %>
          <div class="bg-white rounded-2xl p-6 shadow-soft border border-slate-100 flex flex-col sm:flex-row gap-5 items-start">
            <% if award.image.attached? %>
              <%= image_tag award.image, alt: award.title, loading: "lazy", class: "w-full sm:w-36 h-44 sm:h-36 rounded-xl object-cover object-top flex-shrink-0 border border-slate-100" %>
            <% end %>
            <div>
              <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold mb-2 <%= award.founder? ? 'bg-amber-100 text-amber-800' : 'bg-brand-blue/10 text-brand-blue' %>">
                <%= award.recipient_label %>
              </span>
              <h3 class="font-heading font-bold text-lg text-brand-gray-900"><%= award.title %></h3>
              <p class="text-xs font-semibold text-brand-red mt-0.5 mb-2"><%= award.issuing_organization %></p>
              <p class="text-slate-600 text-sm leading-relaxed"><%= award.description %></p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<!-- Dynamic Team Section (CMS-driven) -->
<% if @team_members.any? %>
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-brand-red font-semibold text-sm uppercase tracking-wider">Leadership &amp; Consultants</span>
        <h2 class="font-heading text-3xl font-bold text-brand-gray-900 mt-2 mb-4">Meet Our Team</h2>
        <p class="text-gray-500">Experienced travel, visa, education, and corporate specialists dedicated to your success.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <% @team_members.each do |member| %>
          <div class="bg-brand-gray-50 rounded-2xl p-6 text-center shadow-soft">
            <div class="w-28 h-28 mx-auto rounded-full overflow-hidden bg-brand-blue/10 flex items-center justify-center font-heading font-bold text-2xl text-brand-blue mb-4">
              <% if member.image.attached? %>
                <%= image_tag member.image, class: "w-full h-full object-cover" %>
              <% else %>
                <%= member.name.split.map(&:first).join.first(2).upcase %>
              <% end %>
            </div>
            <h3 class="font-heading font-bold text-xl text-brand-gray-900"><%= member.name %></h3>
            <p class="text-brand-red text-sm font-semibold mb-3"><%= member.role %></p>
            <p class="text-gray-500 text-sm leading-relaxed"><%= member.bio %></p>
          </div>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<!-- CTA -->
<section class="py-20 bg-brand-blue">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-6">Ready to Start Your Journey?</h2>
    <p class="text-blue-100 text-lg mb-8">Contact our Warri office or chat with us online for a personalized consultation.</p>
    <%= link_to "Get in Touch", contact_path, class: "inline-block bg-white text-brand-blue font-bold px-8 py-4 rounded-full shadow-lg hover:bg-gray-50 hover:-translate-y-0.5 transition-all" %>
  </div>
</section>
