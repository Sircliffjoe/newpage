<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; color: #1e293b;">
  <div style="background: #0f1c2f; padding: 20px 24px; border-radius: 10px 10px 0 0;">
    <h2 style="color: #ffffff; margin: 0; font-size: 18px;">New Website Inquiry Received</h2>
  </div>
  <div style="background: #ffffff; padding: 24px; border: 1px solid #e2e8f0; border-top: none; border-radius: 0 0 10px 10px;">
    <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
      <tr><td style="padding: 8px 0; color: #64748b; width: 130px;"><strong>Name:</strong></td><td><%= @submission.name %></td></tr>
      <tr><td style="padding: 8px 0; color: #64748b;"><strong>Email:</strong></td><td><%= @submission.email %></td></tr>
      <tr><td style="padding: 8px 0; color: #64748b;"><strong>Phone:</strong></td><td><%= @submission.phone.presence || "Not provided" %></td></tr>
      <tr><td style="padding: 8px 0; color: #64748b;"><strong>Subject:</strong></td><td><%= @submission.subject.presence || "General Inquiry" %></td></tr>
    </table>
    <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 16px 0;">
    <p style="font-size: 13px; color: #64748b; margin-bottom: 6px;"><strong>Message:</strong></p>
    <div style="background: #f8fafc; padding: 14px; border-radius: 8px;"><%= simple_format(@submission.message) %></div>
  </div>
</div>
