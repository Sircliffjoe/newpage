<% hero_bg = cms_image_url(@page&.hero_image, "https://images.unsplash.com/photo-1488646953014-85cb44e25828?q=80&w=2035&auto=format&fit=crop") %>

<div data-controller="lightbox" data-action="keydown@window->lightbox#keydown">
  <%= render "shared/page_header",
    title: @page&.hero_title.presence || "Our Photo Gallery",
    subtitle: @page&.hero_subtitle.presence || "A visual journey through successful visa approvals, student departures, memorable tours, and our Warri office.",
    eyebrow: "Moments & Milestones",
    bg_image: hero_bg,
    breadcrumbs: [["Home", root_path], ["Gallery", nil]] %>

  <!-- Category Filters -->
  <section class="py-5 bg-white border-b border-gray-100 sticky top-20 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap gap-2.5 justify-center">
        <%= link_to "All Photos", gallery_path, class: "px-4 py-2 rounded-full text-sm font-semibold #{params[:category].blank? ? 'bg-brand-blue text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'} transition-colors" %>
        <% @categories.each do |cat| %>
          <%= link_to cat.humanize, gallery_path(category: cat), class: "px-4 py-2 rounded-full text-sm font-semibold #{params[:category] == cat ? 'bg-brand-blue text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'} transition-colors" %>
        <% end %>
      </div>
    </div>
  </section>

  <!-- Gallery Grid -->
  <section class="py-16 bg-brand-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <% attached_images = @gallery_images.select { |img| img.image.attached? } %>
      <% if attached_images.any? %>
        <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6">
          <% attached_images.each do |image_record| %>
            <a href="<%= url_for(image_record.image) %>"
               data-action="click->lightbox#open"
               data-url="<%= url_for(image_record.image) %>"
               data-caption="<%= [image_record.title, image_record.caption].compact_blank.join(' — ') %>"
               class="block relative group rounded-2xl overflow-hidden shadow-soft break-inside-avoid bg-white">
              <%= image_tag image_record.image, alt: image_record.title, loading: "lazy", class: "w-full h-auto transform group-hover:scale-105 transition-transform duration-500" %>
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-5">
                <h4 class="text-white font-heading font-bold text-base"><%= image_record.title %></h4>
                <% if image_record.caption.present? %>
                  <p class="text-slate-200 text-xs mt-1"><%= image_record.caption %></p>
                <% end %>
                <span class="text-brand-red-light text-[11px] font-semibold uppercase mt-2"><%= image_record.category&.humanize %></span>
              </div>
            </a>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-20 bg-white rounded-2xl shadow-soft">
          <h3 class="text-xl font-heading font-bold text-slate-700">Gallery Photos Coming Soon</h3>
          <p class="text-slate-400 text-sm mt-2">Upload photos from the Admin CMS to showcase client journeys and tours here.</p>
        </div>
      <% end %>
    </div>
  </section>

  <!-- Lightbox Modal -->
  <div data-lightbox-target="modal" data-action="click->lightbox#close" class="hidden fixed inset-0 z-50 bg-black/90 flex items-center justify-center p-4">
    <div class="max-w-5xl w-full text-center" onclick="event.stopPropagation()">
      <button type="button" data-action="click->lightbox#close" class="mb-4 ml-auto block text-white/80 hover:text-white text-sm font-semibold cursor-pointer">Close ✕</button>
      <img data-lightbox-target="image" src="" alt="" class="max-h-[80vh] mx-auto rounded-xl shadow-2xl">
      <p data-lightbox-target="caption" class="text-white/90 text-sm mt-4"></p>
    </div>
  </div>
</div>
