<%= render layout: "shared/page_header", locals: {
  title: "Search NewPage Integrity",
  subtitle: "Find services, visa destinations, blog guides, and frequently asked questions.",
  eyebrow: "Sitewide Search",
  compact: true,
  breadcrumbs: [["Home", root_path], ["Search", nil]]
} do %>
  <%= form_with url: search_path, method: :get, class: "flex flex-col sm:flex-row gap-3 w-full max-w-2xl" do %>
    <%= text_field_tag :q, @query, placeholder: "Search visas, UK study abroad, CAC registration, destinations...", autofocus: true,
          class: "flex-1 px-6 py-4 rounded-full bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-red shadow-lg" %>
    <%= submit_tag "Search", class: "px-8 py-4 rounded-full bg-brand-red hover:bg-brand-red-light text-white font-semibold cursor-pointer shadow-lg transition-colors" %>
  <% end %>
<% end %>

<section class="py-16 bg-brand-gray-50">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    <% if @query.blank? %>
      <p class="text-center text-slate-500">Enter a keyword above to search across Services, Destinations, Blog Posts, and FAQs.</p>
    <% else %>
      <% total = @services.size + @destinations.size + @blog_posts.size + @faqs.size %>
      <p class="text-sm text-slate-500">Found <strong><%= total %></strong> result(s) for "<strong><%= @query %></strong>".</p>

      <% if @services.any? %>
        <div>
          <h2 class="font-heading text-xl font-bold text-brand-blue mb-4">Services (<%= @services.size %>)</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <% @services.each do |s| %>
              <%= link_to service_path(slug: s.slug), class: "bg-white p-5 rounded-xl shadow-xs hover:shadow-md transition-shadow block" do %>
                <span class="text-xs font-semibold text-brand-red uppercase"><%= s.category.humanize %></span>
                <h3 class="font-heading font-bold text-slate-900 mt-1"><%= s.title %></h3>
                <p class="text-xs text-slate-500 mt-1"><%= s.short_description.presence || strip_tags(s.description.to_s).truncate(100) %></p>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @destinations.any? %>
        <div>
          <h2 class="font-heading text-xl font-bold text-brand-blue mb-4">Destinations (<%= @destinations.size %>)</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <% @destinations.each do |d| %>
              <%= link_to destination_path(slug: d.slug), class: "bg-white p-5 rounded-xl shadow-xs hover:shadow-md transition-shadow block" do %>
                <h3 class="font-heading font-bold text-slate-900"><%= flag_emoji(d.country_code) %> <%= d.name %></h3>
                <p class="text-xs text-slate-500 mt-1"><%= d.short_description.presence || strip_tags(d.description.to_s).truncate(100) %></p>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @blog_posts.any? %>
        <div>
          <h2 class="font-heading text-xl font-bold text-brand-blue mb-4">Blog Articles (<%= @blog_posts.size %>)</h2>
          <div class="space-y-3">
            <% @blog_posts.each do |p| %>
              <%= link_to blog_post_path(slug: p.slug), class: "bg-white p-5 rounded-xl shadow-xs hover:shadow-md transition-shadow block" do %>
                <h3 class="font-heading font-bold text-slate-900"><%= p.title %></h3>
                <p class="text-xs text-slate-500 mt-1"><%= p.excerpt %></p>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @faqs.any? %>
        <div>
          <h2 class="font-heading text-xl font-bold text-brand-blue mb-4">FAQs (<%= @faqs.size %>)</h2>
          <div class="space-y-3">
            <% @faqs.each do |f| %>
              <div class="bg-white p-5 rounded-xl shadow-xs">
                <h3 class="font-semibold text-slate-900 text-sm"><%= f.question %></h3>
                <p class="text-xs text-slate-600 mt-2"><%= f.answer %></p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</section>
