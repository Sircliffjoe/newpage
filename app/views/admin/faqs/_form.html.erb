<div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6 max-w-3xl">
  <%= form_with model: [:admin, @faq], class: "space-y-5" do |form| %>
    <% if @faq.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl text-sm">
        <ul class="list-disc list-inside">
          <% @faq.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :question, class: "block text-sm font-semibold text-slate-700 mb-1" %>
      <%= form.text_field :question, required: true, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
    </div>

    <div>
      <%= form.label :answer, class: "block text-sm font-semibold text-slate-700 mb-1" %>
      <%= form.text_area :answer, rows: 5, required: true, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-center">
      <div>
        <%= form.label :category, class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.select :category, Faq.categories.keys.map { |k| [k.humanize, k] }, {}, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
      <div>
        <%= form.label :position, "Display Order", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.number_field :position, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
      <div class="flex items-center pt-5">
        <%= form.check_box :published, class: "h-4 w-4 text-brand-blue rounded border-slate-300" %>
        <%= form.label :published, "Published", class: "ml-2 text-sm font-medium text-slate-700" %>
      </div>
    </div>

    <div class="flex gap-3 pt-2">
      <%= form.submit class: "px-6 py-2.5 bg-brand-blue hover:bg-brand-blue-light text-white rounded-xl text-sm font-semibold cursor-pointer" %>
      <%= link_to "Cancel", admin_faqs_path, class: "px-5 py-2.5 border border-slate-300 text-slate-700 rounded-xl text-sm font-semibold" %>
    </div>
  <% end %>
</div>
