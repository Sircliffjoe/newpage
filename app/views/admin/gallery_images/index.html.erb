<% content_for :header, "Photo Gallery" %>

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
  <div>
    <h2 class="font-heading text-2xl font-bold text-slate-900">Photo Gallery</h2>
    <p class="text-sm text-slate-500">Upload and organize travel, visa approval, student, office, and event photos.</p>
  </div>
  <%= link_to "+ Upload Photo", new_admin_gallery_image_path, class: "px-4 py-2.5 bg-brand-blue hover:bg-brand-blue-light text-white rounded-xl text-sm font-semibold shadow-xs" %>
</div>

<% if @gallery_images.any? %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @gallery_images.each do |item| %>
      <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden flex flex-col">
        <div class="h-48 bg-slate-100 overflow-hidden relative">
          <% if item.image.attached? %>
            <%= image_tag item.image, class: "w-full h-full object-cover" %>
          <% else %>
            <div class="w-full h-full flex items-center justify-center text-slate-400 text-xs">No image uploaded</div>
          <% end %>
          <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full text-xs font-semibold bg-black/60 text-white"><%= item.category&.humanize %></span>
          <span class="absolute top-3 right-3 px-2.5 py-1 rounded-full text-xs font-semibold <%= item.published? ? 'bg-emerald-500 text-white' : 'bg-slate-600 text-white' %>">
            <%= item.published? ? "Live" : "Hidden" %>
          </span>
        </div>
        <div class="p-4 flex-1 flex flex-col justify-between">
          <div>
            <h3 class="font-bold text-slate-900 text-sm"><%= item.title %></h3>
            <p class="text-xs text-slate-500 mt-1 line-clamp-2"><%= item.caption %></p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex justify-between items-center text-xs">
            <%= link_to "Edit", edit_admin_gallery_image_path(item), class: "font-semibold text-brand-blue hover:underline" %>
            <%= button_to "Delete", admin_gallery_image_path(item), method: :delete, data: { turbo_confirm: "Delete this photo?" }, class: "font-semibold text-red-600 hover:underline cursor-pointer" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="bg-white rounded-2xl border border-slate-200/80 p-12 text-center">
    <p class="text-slate-500 text-sm mb-4">No photos uploaded yet.</p>
    <%= link_to "Upload Your First Photo", new_admin_gallery_image_path, class: "px-5 py-2.5 bg-brand-blue text-white rounded-xl text-sm font-semibold" %>
  </div>
<% end %>
