<div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6 max-w-3xl">
  <%= form_with model: [:admin, @gallery_image], class: "space-y-6" do |form| %>
    <% if @gallery_image.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl text-sm">
        <ul class="list-disc list-inside">
          <% @gallery_image.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        </ul>
      </div>
    <% end %>

    <div class="p-5 rounded-xl border-2 border-dashed border-slate-200 bg-slate-50 text-center">
      <%= form.label :image, "Photo File", class: "block text-xs font-bold uppercase text-slate-600 mb-3" %>
      <% if @gallery_image.image.attached? %>
        <div class="mb-4 flex justify-center">
          <%= image_tag @gallery_image.image, class: "h-44 w-auto rounded-xl border shadow-xs object-cover" %>
        </div>
      <% end %>
      <%= form.file_field :image, accept: "image/*", class: "block mx-auto text-sm text-slate-600 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-brand-blue file:text-white hover:file:bg-brand-blue-light cursor-pointer" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div>
        <%= form.label :title, class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.text_field :title, required: true, placeholder: "e.g. UK Visa Approval Celebration", class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
      <div>
        <%= form.label :category, class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.select :category, GalleryImage.categories.keys.map { |k| [k.humanize, k] }, {}, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
    </div>

    <div>
      <%= form.label :caption, class: "block text-sm font-semibold text-slate-700 mb-1" %>
      <%= form.text_area :caption, rows: 3, placeholder: "Short description shown on hover and in lightbox...", class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 items-center">
      <div>
        <%= form.label :position, "Display Order", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.number_field :position, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
      <div class="flex items-center pt-5">
        <%= form.check_box :published, class: "h-4 w-4 text-brand-blue rounded border-slate-300" %>
        <%= form.label :published, "Published (visible on website)", class: "ml-2 text-sm font-medium text-slate-700" %>
      </div>
    </div>

    <div class="flex gap-3 pt-2">
      <%= form.submit class: "px-6 py-2.5 bg-brand-blue hover:bg-brand-blue-light text-white rounded-xl text-sm font-semibold cursor-pointer" %>
      <%= link_to "Cancel", admin_gallery_images_path, class: "px-5 py-2.5 border border-slate-300 text-slate-700 rounded-xl text-sm font-semibold" %>
    </div>
  <% end %>
</div>
