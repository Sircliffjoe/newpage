<div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6 max-w-4xl">
  <%= form_with model: [:admin, @blog_post], class: "space-y-6" do |form| %>
    <% if @blog_post.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl text-sm">
        <ul class="list-disc list-inside">
          <% @blog_post.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :title, class: "block text-sm font-semibold text-slate-700 mb-1" %>
      <%= form.text_field :title, required: true, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <div>
        <%= form.label :blog_category_id, "Category", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.collection_select :blog_category_id, BlogCategory.order(:name), :id, :name, { prompt: "Select category" }, { required: true, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" } %>
      </div>
      <div>
        <%= form.label :status, class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.select :status, BlogPost.statuses.keys.map { |k| [k.humanize, k] }, {}, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
      <div>
        <%= form.label :published_at, "Publish Date", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.datetime_local_field :published_at, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
    </div>

    <div>
      <%= form.label :excerpt, "Short Excerpt", class: "block text-sm font-semibold text-slate-700 mb-1" %>
      <%= form.text_area :excerpt, rows: 2, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
    </div>

    <div>
      <%= form.label :body, "Article Content", class: "block text-sm font-semibold text-slate-700 mb-1" %>
      <%= form.rich_text_area :body %>
    </div>

    <div class="p-4 rounded-xl border-2 border-dashed border-slate-200 bg-slate-50">
      <%= form.label :featured_image, "Featured Image", class: "block text-xs font-bold uppercase text-slate-600 mb-2" %>
      <% if @blog_post.featured_image.attached? %>
        <div class="mb-3">
          <%= image_tag @blog_post.featured_image, class: "h-36 w-auto rounded-xl border object-cover" %>
        </div>
      <% end %>
      <%= form.file_field :featured_image, accept: "image/*", class: "block w-full text-xs text-slate-600" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div>
        <%= form.label :tags, "Tags (comma-separated)", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.text_field :tags, placeholder: "uk visa, study abroad, warri", class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
      <div>
        <%= form.label :meta_title, "SEO Meta Title", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.text_field :meta_title, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
    </div>

    <div>
      <%= form.label :meta_description, "SEO Meta Description", class: "block text-sm font-semibold text-slate-700 mb-1" %>
      <%= form.text_area :meta_description, rows: 2, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
    </div>

    <label class="inline-flex items-center text-sm font-medium text-slate-700">
      <%= form.check_box :featured, class: "h-4 w-4 text-brand-blue rounded border-slate-300 mr-2" %> Featured Article
    </label>

    <div class="flex gap-3 pt-2">
      <%= form.submit class: "px-6 py-2.5 bg-brand-blue hover:bg-brand-blue-light text-white rounded-xl text-sm font-semibold cursor-pointer" %>
      <%= link_to "Cancel", admin_blog_posts_path, class: "px-5 py-2.5 border border-slate-300 text-slate-700 rounded-xl text-sm font-semibold" %>
    </div>
  <% end %>
</div>
