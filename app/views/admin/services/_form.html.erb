<div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6 max-w-4xl">
  <%= form_with model: [:admin, @service], class: "space-y-6" do |form| %>
    <% if @service.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl text-sm">
        <ul class="list-disc list-inside">
          <% @service.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div>
        <%= form.label :title, class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.text_field :title, required: true, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
      <div>
        <%= form.label :category, class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.select :category, Service.categories.keys.map { |k| [k.humanize, k] }, {}, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
    </div>

    <div>
      <%= form.label :short_description, "Short Summary (shown on cards)", class: "block text-sm font-semibold text-slate-700 mb-1" %>
      <%= form.text_area :short_description, rows: 2, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
    </div>

    <div>
      <%= form.label :description, "Full Description", class: "block text-sm font-semibold text-slate-700 mb-1" %>
      <%= form.rich_text_area :description %>
    </div>

    <div class="p-4 rounded-xl border-2 border-dashed border-slate-200 bg-slate-50">
      <%= form.label :hero_image, "Service Hero / Card Image", class: "block text-xs font-bold uppercase text-slate-600 mb-2" %>
      <% if @service.hero_image.attached? %>
        <div class="mb-3">
          <%= image_tag @service.hero_image, class: "h-36 w-auto rounded-xl border object-cover" %>
        </div>
      <% end %>
      <%= form.file_field :hero_image, accept: "image/*", class: "block w-full text-xs text-slate-600" %>
    </div>

    <div class="p-4 rounded-xl border-2 border-dashed border-slate-200 bg-slate-50">
      <%= form.label :flyers, "Additional Program Flyers / Supporting Images (Multiple)", class: "block text-xs font-bold uppercase text-slate-600 mb-2" %>
      <% if @service.flyers.attached? %>
        <div class="flex flex-wrap gap-3 mb-3">
          <% @service.flyers.each do |flyer| %>
            <%= image_tag flyer, class: "h-24 w-auto rounded-lg border object-cover" %>
          <% end %>
        </div>
      <% end %>
      <%= form.file_field :flyers, multiple: true, accept: "image/*", class: "block w-full text-xs text-slate-600" %>
      <p class="text-[11px] text-slate-500 mt-1">Uploading new files appends to existing flyers.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div>
        <%= form.label :benefits, "Key Benefits (one per line)", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.text_area :benefits, rows: 4, placeholder: "24/7 Support\nFast Turnaround\nTransparent Pricing", class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
      <div>
        <%= form.label :requirements, "Requirements (one per line)", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.text_area :requirements, rows: 4, placeholder: "Valid Passport\nPassport Photograph\nProof of Funds", class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 items-center">
      <div>
        <%= form.label :position, "Display Order", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.number_field :position, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
      <div class="flex items-center pt-5">
        <%= form.check_box :published, class: "h-4 w-4 text-brand-blue rounded border-slate-300" %>
        <%= form.label :published, "Published", class: "ml-2 text-sm font-medium text-slate-700" %>
      </div>
      <div class="flex items-center pt-5">
        <%= form.check_box :featured, class: "h-4 w-4 text-brand-blue rounded border-slate-300" %>
        <%= form.label :featured, "Featured on Home", class: "ml-2 text-sm font-medium text-slate-700" %>
      </div>
    </div>

    <div class="flex gap-3 pt-2">
      <%= form.submit class: "px-6 py-2.5 bg-brand-blue hover:bg-brand-blue-light text-white rounded-xl text-sm font-semibold cursor-pointer" %>
      <%= link_to "Cancel", admin_services_path, class: "px-5 py-2.5 border border-slate-300 text-slate-700 rounded-xl text-sm font-semibold" %>
    </div>
  <% end %>
</div>
