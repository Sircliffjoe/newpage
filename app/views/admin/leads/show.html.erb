<% content_for :header, "Lead: #{@lead.name}" %>

<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
  <div>
    <h2 class="font-heading text-2xl font-bold text-slate-900"><%= @lead.name %></h2>
    <p class="text-sm text-slate-500"><%= @lead.email %> <%= "• #{@lead.phone}" if @lead.phone.present? %></p>
  </div>
  <div class="flex gap-2">
    <%= link_to "✉ Email Client", new_admin_email_path(to: "#{@lead.name} <#{@lead.email}>", subject: "Regarding your #{@lead.service_type.humanize} inquiry", contact_type: "lead"), class: "px-4 py-2 bg-brand-blue hover:bg-brand-blue-light text-white rounded-xl text-sm font-semibold" %>
    <%= link_to "← All Leads", admin_leads_path, class: "px-4 py-2 border border-slate-300 text-slate-700 rounded-xl text-sm font-semibold" %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6 space-y-4">
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 text-sm border-b border-slate-100 pb-4">
        <div>
          <div class="text-xs text-slate-400 uppercase font-semibold">Service Type</div>
          <div class="font-semibold text-slate-900 mt-1"><%= @lead.service_type.humanize %></div>
        </div>
        <div>
          <div class="text-xs text-slate-400 uppercase font-semibold">Status</div>
          <div class="font-semibold text-brand-blue mt-1"><%= @lead.status.humanize %></div>
        </div>
        <div>
          <div class="text-xs text-slate-400 uppercase font-semibold">Source</div>
          <div class="font-semibold text-slate-700 mt-1"><%= @lead.source.presence || "Website" %></div>
        </div>
      </div>

      <div>
        <div class="text-xs text-slate-400 uppercase font-semibold mb-2">Client Message</div>
        <div class="bg-slate-50 rounded-xl p-4 text-sm text-slate-700">
          <%= simple_format(@lead.message.presence || "No message provided.") %>
        </div>
      </div>
    </div>

    <!-- Internal Notes Thread -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6">
      <h3 class="font-heading text-lg font-bold text-slate-900 mb-4">Consultant Notes</h3>

      <%= form_with model: [:admin, @lead, @note], class: "mb-6 space-y-3" do |f| %>
        <%= f.text_area :body, rows: 3, required: true, placeholder: "Add a follow-up note, call summary, or next step...", class: "w-full rounded-xl border-slate-300 text-sm" %>
        <%= f.submit "Add Note", class: "px-4 py-2 bg-brand-blue hover:bg-brand-blue-light text-white rounded-xl text-xs font-semibold cursor-pointer" %>
      <% end %>

      <div class="space-y-3">
        <% @notes.each do |note| %>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
            <div class="flex justify-between items-center mb-1">
              <span class="text-xs font-bold text-slate-800"><%= note.author.full_name %></span>
              <div class="flex items-center gap-3">
                <span class="text-xs text-slate-400"><%= note.created_at.strftime("%b %d, %Y %H:%M") %></span>
                <%= button_to "×", admin_lead_note_path(@lead, note), method: :delete, class: "text-xs text-red-500 hover:text-red-700 cursor-pointer" %>
              </div>
            </div>
            <p class="text-sm text-slate-700"><%= note.body %></p>
          </div>
        <% end %>
        <% if @notes.empty? %>
          <p class="text-xs text-slate-400">No internal notes yet.</p>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Quick Status Actions -->
  <div class="space-y-5">
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6">
      <h3 class="font-heading text-base font-bold text-slate-900 mb-4">Update Status</h3>
      <div class="space-y-2">
        <% [
          [:contacted, "Mark as Contacted", "bg-amber-50 text-amber-800 hover:bg-amber-100"],
          [:pending, "Mark as Pending", "bg-blue-50 text-blue-800 hover:bg-blue-100"],
          [:converted, "Mark as Converted", "bg-emerald-50 text-emerald-800 hover:bg-emerald-100"],
          [:closed, "Mark as Closed", "bg-slate-100 text-slate-700 hover:bg-slate-200"]
        ].each do |status_key, label, classes| %>
          <%= button_to label, admin_lead_path(@lead), method: :patch, params: { lead: { status: status_key } },
                class: "w-full text-left px-4 py-2.5 rounded-xl text-sm font-semibold transition-colors cursor-pointer #{classes}" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
