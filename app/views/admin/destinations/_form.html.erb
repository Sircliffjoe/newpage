<div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6 max-w-4xl">
  <%= form_with model: [:admin, @destination], class: "space-y-6" do |form| %>
    <% if @destination.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl text-sm">
        <ul class="list-disc list-inside">
          <% @destination.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <div>
        <%= form.label :name, "Country / City Name", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.text_field :name, required: true, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
      <div>
        <%= form.label :country_code, "ISO Code (e.g. GB, CA, US, AE)", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.text_field :country_code, maxlength: 2, placeholder: "GB", class: "w-full rounded-xl border-slate-300 shadow-xs text-sm uppercase" %>
      </div>
      <div>
        <%= form.label :category, class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.select :category, Destination.categories.keys.map { |k| [k.humanize, k] }, {}, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
    </div>

    <div>
      <%= form.label :short_description, "Short Summary", class: "block text-sm font-semibold text-slate-700 mb-1" %>
      <%= form.text_area :short_description, rows: 2, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
    </div>

    <div>
      <%= form.label :description, "Full Overview", class: "block text-sm font-semibold text-slate-700 mb-1" %>
      <%= form.rich_text_area :description %>
    </div>

    <div class="p-4 rounded-xl border-2 border-dashed border-slate-200 bg-slate-50">
      <%= form.label :hero_image, "Destination Cover Image", class: "block text-xs font-bold uppercase text-slate-600 mb-2" %>
      <% if @destination.hero_image.attached? %>
        <div class="mb-3">
          <%= image_tag @destination.hero_image, class: "h-36 w-auto rounded-xl border object-cover" %>
        </div>
      <% end %>
      <%= form.file_field :hero_image, accept: "image/*", class: "block w-full text-xs text-slate-600" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div>
        <%= form.label :cost_estimate, "Cost Estimate", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.text_field :cost_estimate, placeholder: "e.g. From £12,000 / year or $1,800", class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
      <div>
        <%= form.label :position, "Display Order", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.number_field :position, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
    </div>

    <div>
      <%= form.label :requirements, "Visa / Entry Requirements (one per line)", class: "block text-sm font-semibold text-slate-700 mb-1" %>
      <%= form.text_area :requirements, rows: 4, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
    </div>

    <div class="flex flex-wrap gap-6">
      <label class="inline-flex items-center text-sm font-medium text-slate-700">
        <%= form.check_box :visa_required, class: "h-4 w-4 text-brand-blue rounded border-slate-300 mr-2" %> Visa Required
      </label>
      <label class="inline-flex items-center text-sm font-medium text-slate-700">
        <%= form.check_box :published, class: "h-4 w-4 text-brand-blue rounded border-slate-300 mr-2" %> Published
      </label>
      <label class="inline-flex items-center text-sm font-medium text-slate-700">
        <%= form.check_box :featured, class: "h-4 w-4 text-brand-blue rounded border-slate-300 mr-2" %> Featured on Home
      </label>
    </div>

    <div class="flex gap-3 pt-2">
      <%= form.submit class: "px-6 py-2.5 bg-brand-blue hover:bg-brand-blue-light text-white rounded-xl text-sm font-semibold cursor-pointer" %>
      <%= link_to "Cancel", admin_destinations_path, class: "px-5 py-2.5 border border-slate-300 text-slate-700 rounded-xl text-sm font-semibold" %>
    </div>
  <% end %>
</div>
