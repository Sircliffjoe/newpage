<div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6 max-w-2xl">
  <%= form_with model: [:admin, @user], class: "space-y-5" do |f| %>
    <% if @user.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl text-sm">
        <ul class="list-disc list-inside">
          <% @user.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :first_name, class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= f.text_field :first_name, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
      <div>
        <%= f.label :last_name, class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= f.text_field :last_name, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :email, class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= f.email_field :email, required: true, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
      <div>
        <%= f.label :role, class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= f.select :role, User.roles.keys.map { |r| [r.humanize, r] }, {}, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :password, class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= f.password_field :password, required: @user.new_record?, placeholder: (@user.persisted? ? "Leave blank to keep current" : ""), class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
      <div>
        <%= f.label :password_confirmation, class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= f.password_field :password_confirmation, required: @user.new_record?, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
    </div>

    <div class="flex gap-3 pt-2">
      <%= f.submit class: "px-5 py-2.5 bg-brand-blue hover:bg-brand-blue-light text-white rounded-xl text-sm font-semibold cursor-pointer" %>
      <%= link_to "Cancel", admin_users_path, class: "px-5 py-2.5 border border-slate-300 text-slate-700 rounded-xl text-sm font-semibold" %>
    </div>
  <% end %>
</div>
