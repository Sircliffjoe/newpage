<div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6 max-w-4xl">
  <%= form_with model: [:admin, @award], class: "space-y-6" do |form| %>
    <% if @award.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl text-sm">
        <ul class="list-disc list-inside">
          <% @award.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div>
        <%= form.label :title, "Award / Honour Title", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.text_field :title, required: true, placeholder: "e.g., Travel Agency of the Year", class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
      <div>
        <%= form.label :recipient_type, "Award Recipient Type", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.select :recipient_type,
              [["Company (NewPage Integrity Travels & Tours)", "company"], ["Founder & CEO (Mrs. Ify Adegoke)", "founder"]],
              {}, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div>
        <%= form.label :recipient_name, "Recipient Full Name", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.text_field :recipient_name, required: true, placeholder: "NewPage Integrity Travels & Tours Limited or Mrs. Ify Adegoke", class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
      <div>
        <%= form.label :issuing_organization, "Issuing Organization / Body", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.text_field :issuing_organization, required: true, placeholder: "e.g., NANTA Eastern Zone or African Institute of Public Leadership", class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <div>
        <%= form.label :awarded_on, "Date Awarded", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.date_field :awarded_on, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
      <div>
        <%= form.label :location, "Event / Location", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.text_field :location, placeholder: "e.g., Owerri, Imo State", class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
      <div>
        <%= form.label :category, "Category / Tag", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.text_field :category, placeholder: "e.g., Industry Excellence, Leadership Fellowship", class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
    </div>

    <div>
      <%= form.label :description, "Description & Citation", class: "block text-sm font-semibold text-slate-700 mb-1" %>
      <%= form.text_area :description, rows: 4, placeholder: "Describe the significance of this award or achievement...", class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
    </div>

    <div class="p-4 rounded-xl border-2 border-dashed border-slate-200 bg-slate-50">
      <%= form.label :image, "Award Photo / Certificate / Banner", class: "block text-xs font-bold uppercase text-slate-600 mb-2" %>
      <% if @award.image.attached? %>
        <div class="mb-3">
          <%= image_tag @award.image, class: "h-40 w-auto rounded-xl border object-cover" %>
        </div>
      <% end %>
      <%= form.file_field :image, accept: "image/*", class: "block w-full text-xs text-slate-600" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 items-center">
      <div>
        <%= form.label :position, "Display Order", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= form.number_field :position, class: "w-full rounded-xl border-slate-300 shadow-xs text-sm" %>
      </div>
      <div class="flex items-center pt-5">
        <%= form.check_box :published, class: "h-4 w-4 text-brand-blue rounded border-slate-300" %>
        <%= form.label :published, "Published", class: "ml-2 text-sm font-medium text-slate-700" %>
      </div>
      <div class="flex items-center pt-5">
        <%= form.check_box :featured, class: "h-4 w-4 text-brand-blue rounded border-slate-300" %>
        <%= form.label :featured, "Featured on Home & About", class: "ml-2 text-sm font-medium text-slate-700" %>
      </div>
    </div>

    <div class="flex gap-3 pt-2">
      <%= form.submit class: "px-6 py-2.5 bg-brand-blue hover:bg-brand-blue-light text-white rounded-xl text-sm font-semibold cursor-pointer" %>
      <%= link_to "Cancel", admin_awards_path, class: "px-5 py-2.5 border border-slate-300 text-slate-700 rounded-xl text-sm font-semibold" %>
    </div>
  <% end %>
</div>
