<% content_for :header, "Email Center (Brevo)" %>

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
  <div>
    <h2 class="font-heading text-2xl font-bold text-slate-900">Email Messages</h2>
    <p class="text-sm text-slate-500">Send announcements, follow-ups, and newsletters powered by Brevo API.</p>
  </div>
  <%= link_to "✉ Compose Email", new_admin_email_path, class: "px-5 py-2.5 bg-brand-blue hover:bg-brand-blue-light text-white rounded-xl text-sm font-semibold shadow-xs" %>
</div>

<% if ENV["BREVO_API_KEY"].blank? %>
  <div class="bg-amber-50 border border-amber-200 text-amber-900 px-4 py-3 rounded-xl mb-6 text-sm">
    <strong>Brevo API Key not configured yet:</strong> Emails will be logged in simulation mode until <code class="font-mono bg-amber-100 px-1.5 py-0.5 rounded">BREVO_API_KEY</code> is added to your environment.
  </div>
<% end %>

<div class="grid grid-cols-3 gap-4 mb-6">
  <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-xs">
    <div class="text-xs font-semibold uppercase text-slate-400">Total Logged</div>
    <div class="text-2xl font-heading font-bold text-slate-900 mt-1"><%= @stats[:total] %></div>
  </div>
  <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-xs">
    <div class="text-xs font-semibold uppercase text-emerald-600">Delivered</div>
    <div class="text-2xl font-heading font-bold text-emerald-700 mt-1"><%= @stats[:sent] %></div>
  </div>
  <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-xs">
    <div class="text-xs font-semibold uppercase text-red-600">Failed</div>
    <div class="text-2xl font-heading font-bold text-red-700 mt-1"><%= @stats[:failed] %></div>
  </div>
</div>

<div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-200">
      <thead class="bg-slate-50">
        <tr>
          <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase">Recipient</th>
          <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase">Subject</th>
          <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase">Category</th>
          <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase">Status</th>
          <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase">Sent On</th>
          <th class="px-6 py-3.5 text-right text-xs font-semibold text-slate-500 uppercase">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @emails.each do |email| %>
          <tr class="hover:bg-slate-50/70">
            <td class="px-6 py-4">
              <div class="font-semibold text-sm text-slate-900"><%= email.recipient_name.presence || email.recipient_email %></div>
              <div class="text-xs text-slate-500"><%= email.recipient_email %></div>
            </td>
            <td class="px-6 py-4 text-sm text-slate-700"><%= truncate(email.subject, length: 55) %></td>
            <td class="px-6 py-4">
              <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-50 text-brand-blue"><%= email.contact_type.humanize %></span>
            </td>
            <td class="px-6 py-4">
              <% badge = email.sent? ? "bg-emerald-100 text-emerald-700" : (email.failed? ? "bg-red-100 text-red-700" : "bg-amber-100 text-amber-700") %>
              <span class="px-2.5 py-1 rounded-full text-xs font-semibold <%= badge %>"><%= email.status.capitalize %></span>
            </td>
            <td class="px-6 py-4 text-xs text-slate-500"><%= (email.sent_at || email.created_at).strftime("%b %d, %Y %H:%M") %></td>
            <td class="px-6 py-4 text-right">
              <%= link_to "View", admin_email_path(email), class: "text-sm font-semibold text-brand-blue hover:underline" %>
            </td>
          </tr>
        <% end %>
        <% if @emails.empty? %>
          <tr>
            <td colspan="6" class="px-6 py-12 text-center text-sm text-slate-500">No emails sent yet. Click "Compose Email" to send your first message.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
