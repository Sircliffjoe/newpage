<% content_for :header, "Management Center" %>

<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
  <div>
    <h2 class="font-heading text-2xl font-bold text-slate-900">Welcome back, <%= current_user.first_name.presence || "Admin" %></h2>
    <p class="text-sm text-slate-500">Overview of NewPage Integrity Travels &amp; Tours operations and CMS content.</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= link_to "Manage Page Banners", admin_page_settings_path, class: "px-4 py-2 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 rounded-xl text-sm font-semibold shadow-xs" %>
    <%= link_to "Upload Gallery Photo", new_admin_gallery_image_path, class: "px-4 py-2 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 rounded-xl text-sm font-semibold shadow-xs" %>
    <%= link_to "Compose Email", new_admin_email_path, class: "px-4 py-2 bg-brand-red hover:bg-brand-red-light text-white rounded-xl text-sm font-semibold shadow-xs" %>
  </div>
</div>

<!-- KPI Grid -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-8">
  <% [
    { label: "Total Leads", count: @stats[:total_leads], sub: "#{@stats[:new_leads]} new", link: admin_leads_path, accent: "text-brand-blue bg-blue-50" },
    { label: "Active Services", count: @stats[:services], sub: "Travel, Visa, Study, CAC", link: admin_services_path, accent: "text-emerald-700 bg-emerald-50" },
    { label: "Destinations", count: @stats[:destinations], sub: "Travel & Study countries", link: admin_destinations_path, accent: "text-indigo-700 bg-indigo-50" },
    { label: "Blog Posts", count: @stats[:blog_posts], sub: "News & Visa updates", link: admin_blog_posts_path, accent: "text-amber-700 bg-amber-50" },
    { label: "Gallery Photos", count: @stats[:gallery_images], sub: "ActiveStorage media", link: admin_gallery_images_path, accent: "text-purple-700 bg-purple-50" },
    { label: "Subscribers", count: @stats[:subscribers], sub: "Newsletter audience", link: admin_newsletter_subscribers_path, accent: "text-cyan-700 bg-cyan-50" },
    { label: "Emails Sent", count: @stats[:emails_sent], sub: "Via Brevo API", link: admin_emails_path, accent: "text-rose-700 bg-rose-50" },
    { label: "New Leads", count: @stats[:new_leads], sub: "Needs follow-up", link: admin_leads_path(status: "new_lead"), accent: "text-brand-red bg-red-50" }
  ].each do |card| %>
    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-lg <%= card[:accent] %>"><%= card[:label] %></span>
        <%= link_to "Manage →", card[:link], class: "text-xs font-semibold text-slate-400 hover:text-brand-blue" %>
      </div>
      <div class="text-3xl font-heading font-bold text-slate-900"><%= card[:count] %></div>
      <div class="text-xs text-slate-500 mt-1"><%= card[:sub] %></div>
    </div>
  <% end %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Recent Leads -->
  <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6">
    <div class="flex items-center justify-between mb-5">
      <h3 class="font-heading text-lg font-bold text-slate-900">Recent Leads</h3>
      <%= link_to "View All Leads", admin_leads_path, class: "text-sm font-semibold text-brand-blue hover:underline" %>
    </div>

    <% if @recent_leads.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-xs uppercase text-slate-400 border-b border-slate-100">
              <th class="pb-3 font-semibold">Client</th>
              <th class="pb-3 font-semibold">Service</th>
              <th class="pb-3 font-semibold">Status</th>
              <th class="pb-3 font-semibold text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @recent_leads.each do |lead| %>
              <tr>
                <td class="py-3">
                  <div class="font-semibold text-slate-900"><%= lead.name %></div>
                  <div class="text-xs text-slate-500"><%= lead.email %></div>
                </td>
                <td class="py-3">
                  <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-700"><%= lead.service_type.humanize %></span>
                </td>
                <td class="py-3">
                  <span class="px-2.5 py-1 rounded-full text-xs font-semibold <%= lead.new_lead? ? 'bg-red-100 text-red-700' : 'bg-emerald-100 text-emerald-700' %>">
                    <%= lead.status.humanize %>
                  </span>
                </td>
                <td class="py-3 text-right">
                  <%= link_to "Open", admin_lead_path(lead), class: "text-brand-blue font-semibold hover:underline" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-slate-500 py-6 text-center">No leads captured yet.</p>
    <% end %>
  </div>

  <!-- Recent Contact Messages & Quick Guide -->
  <div class="space-y-6">
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-heading text-lg font-bold text-slate-900">Latest Messages</h3>
        <%= link_to "Inbox", admin_contact_submissions_path, class: "text-xs font-semibold text-brand-blue hover:underline" %>
      </div>

      <% if @recent_contacts.any? %>
        <div class="space-y-4">
          <% @recent_contacts.each do |contact| %>
            <div class="border-b border-slate-100 pb-3 last:border-0 last:pb-0">
              <div class="flex justify-between items-start gap-2">
                <span class="font-semibold text-sm text-slate-900"><%= contact.name %></span>
                <span class="text-[11px] text-slate-400"><%= time_ago_in_words(contact.created_at) %> ago</span>
              </div>
              <div class="text-xs text-brand-blue font-medium"><%= contact.subject.presence || "General Inquiry" %></div>
              <p class="text-xs text-slate-500 mt-1 line-clamp-2"><%= contact.message %></p>
              <div class="mt-2 flex gap-3">
                <%= link_to "View", admin_contact_submission_path(contact), class: "text-xs font-semibold text-slate-600 hover:text-brand-blue" %>
                <%= link_to "Reply via Email", new_admin_email_path(to: "#{contact.name} <#{contact.email}>", subject: "Re: #{contact.subject}", contact_type: "contact"), class: "text-xs font-semibold text-brand-red hover:underline" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-slate-500 text-center py-4">No contact messages yet.</p>
      <% end %>
    </div>

    <div class="bg-brand-blue-dark text-white rounded-2xl p-6 shadow-sm">
      <div class="text-xs uppercase tracking-wider text-brand-red-light font-bold mb-2">CMS Quick Tip</div>
      <h4 class="font-heading font-bold text-lg mb-2">Update Any Page Image</h4>
      <p class="text-xs text-slate-300 leading-relaxed mb-4">
        You can swap hero banners, section photos, headlines, and SEO meta tags for every page on the site from <strong>Site Pages &amp; Banners</strong>.
      </p>
      <%= link_to "Open Page Manager →", admin_page_settings_path, class: "inline-block px-4 py-2 rounded-full bg-white text-brand-blue-dark text-xs font-bold hover:bg-slate-100 transition-colors" %>
    </div>
  </div>
</div>
