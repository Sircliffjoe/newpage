<% content_for :header, "Site Pages & Banners CMS" %>

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
  <div>
    <h2 class="font-heading text-2xl font-bold text-slate-900">Site Pages &amp; Hero Banners</h2>
    <p class="text-sm text-slate-500">Update page headlines, hero images, section images, SEO meta tags, and global contact info.</p>
  </div>
  <%= link_to "+ Add Page Setting", new_admin_page_setting_path, class: "px-4 py-2.5 bg-brand-blue hover:bg-brand-blue-light text-white rounded-xl text-sm font-semibold shadow-xs" %>
</div>

<div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-200">
      <thead class="bg-slate-50">
        <tr>
          <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase">Page</th>
          <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase">Hero Banner</th>
          <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase">Hero Title / SEO</th>
          <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase">Updated</th>
          <th class="px-6 py-3.5 text-right text-xs font-semibold text-slate-500 uppercase">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @page_settings.each do |setting| %>
          <tr class="hover:bg-slate-50/70">
            <td class="px-6 py-4">
              <div class="font-semibold text-slate-900"><%= setting.page_name %></div>
              <div class="text-xs text-slate-400 font-mono">key: <%= setting.key %></div>
            </td>
            <td class="px-6 py-4">
              <% if setting.hero_image.attached? %>
                <%= image_tag setting.hero_image, class: "h-12 w-20 object-cover rounded-lg border border-slate-200" %>
              <% else %>
                <span class="text-xs px-2.5 py-1 rounded-full bg-slate-100 text-slate-500">Default banner</span>
              <% end %>
            </td>
            <td class="px-6 py-4 max-w-xs">
              <div class="text-sm font-medium text-slate-800 truncate"><%= setting.hero_title.presence || "—" %></div>
              <div class="text-xs text-slate-500 truncate"><%= setting.meta_title.presence || "SEO default" %></div>
            </td>
            <td class="px-6 py-4 text-xs text-slate-500"><%= setting.updated_at.strftime("%b %d, %Y") %></td>
            <td class="px-6 py-4 text-right whitespace-nowrap space-x-3">
              <%= link_to "Edit", edit_admin_page_setting_path(setting), class: "text-sm font-semibold text-brand-blue hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
