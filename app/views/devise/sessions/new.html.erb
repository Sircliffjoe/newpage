<div class="mb-6 text-center">
  <h1 class="font-heading text-2xl font-bold text-slate-900">Admin Sign In</h1>
  <p class="text-sm text-slate-500 mt-1">Sign in with your staff or administrator credentials</p>
</div>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
  <div>
    <%= f.label :email, class: "block text-sm font-semibold text-slate-700 mb-1.5" %>
    <%= f.email_field :email,
        autofocus: true,
        autocomplete: "email",
        required: true,
        placeholder: "admin@newpageintegrity.com",
        class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 placeholder-slate-400 shadow-xs focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 focus:outline-none transition" %>
  </div>

  <div>
    <div class="flex items-center justify-between mb-1.5">
      <%= f.label :password, class: "block text-sm font-semibold text-slate-700" %>
      <% if devise_mapping.recoverable? %>
        <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-xs font-semibold text-brand-blue hover:text-brand-red transition-colors" %>
      <% end %>
    </div>
    <%= f.password_field :password,
        autocomplete: "current-password",
        required: true,
        placeholder: "Enter your password",
        class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 placeholder-slate-400 shadow-xs focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 focus:outline-none transition" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="flex items-center">
      <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-slate-300 text-brand-blue focus:ring-brand-blue" %>
      <%= f.label :remember_me, "Keep me signed in", class: "ml-2.5 text-sm text-slate-600 select-none" %>
    </div>
  <% end %>

  <div class="pt-1">
    <%= f.submit "Sign In", class: "w-full rounded-xl bg-brand-blue hover:bg-brand-blue-dark text-white font-semibold py-3 px-4 text-sm shadow-md hover:shadow-lg transition-all cursor-pointer" %>
  </div>
<% end %>
