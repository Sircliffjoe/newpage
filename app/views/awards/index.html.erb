<% hero_bg = cms_image_url(@page&.hero_image, "https://images.unsplash.com/photo-1567427017947-545c5f8d16ad?q=80&w=2070&auto=format&fit=crop") %>

<div data-controller="lightbox" data-action="keydown@window->lightbox#keydown">
  <%= render layout: "shared/page_header", locals: {
    title: @page&.hero_title.presence || "Awards & Recognition",
    subtitle: @page&.hero_subtitle.presence || "Celebrating industry excellence, leadership honours, and milestones achieved by NewPage Integrity Travels & Tours Limited and our Founder & CEO, Mrs. Ify Adegoke.",
    eyebrow: "Honours & Achievements",
    bg_image: hero_bg,
    breadcrumbs: [["Home", root_path], ["Awards & Recognition", nil]]
  } do %>
    <div class="flex flex-col sm:flex-row gap-3.5 justify-center">
      <%= link_to "About Our Founder", about_path, class: "px-7 py-3.5 rounded-full bg-brand-red hover:bg-brand-red-light text-white font-semibold text-sm shadow-lg shadow-brand-red/30 hover:-translate-y-0.5 transition-all" %>
      <%= link_to "Book a Consultation", contact_path, class: "px-7 py-3.5 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold text-sm backdrop-blur-xs hover:-translate-y-0.5 transition-all" %>
    </div>
  <% end %>

  <!-- Recipient Filter Bar -->
  <section class="py-5 bg-white/95 backdrop-blur-md border-b border-slate-200/80 sticky top-20 z-30 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap gap-2.5 justify-center items-center">
        <% [
          { key: nil, label: "All Honours", count: @total_count },
          { key: "company", label: "Company Awards", count: @company_count },
          { key: "founder", label: "Founder & CEO", count: @founder_count }
        ].each do |tab| %>
          <% active = @active_recipient == tab[:key] %>
          <%= link_to(tab[:key] ? awards_path(recipient_type: tab[:key]) : awards_path,
              class: "inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold transition-all #{active ? 'bg-brand-blue text-white shadow-md' : 'bg-slate-100 text-slate-700 hover:bg-slate-200/80 hover:text-brand-blue'}") do %>
            <span><%= tab[:label] %></span>
            <span class="text-xs px-2 py-0.5 rounded-full <%= active ? 'bg-white/20 text-white' : 'bg-white text-slate-500' %>"><%= tab[:count] %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>

  <!-- Awards Showcase Grid -->
  <section class="py-20 bg-brand-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <% if @awards.any? %>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
          <% @awards.each do |award| %>
            <article class="bg-white rounded-3xl shadow-soft border border-slate-100 overflow-hidden group hover:-translate-y-1 hover:shadow-hover transition-all duration-300 flex flex-col">
              <% if award.image.attached? %>
                <a href="<%= url_for(award.image) %>"
                   data-action="click->lightbox#open"
                   data-url="<%= url_for(award.image) %>"
                   data-caption="<%= "#{award.title} — #{award.recipient_name} (#{award.issuing_organization})" %>"
                   class="relative block bg-slate-900 overflow-hidden aspect-[4/3]">
                  <%= image_tag award.image, alt: award.title, loading: "lazy", class: "w-full h-full object-contain bg-slate-950/95 group-hover:scale-[1.02] transition-transform duration-500" %>
                  <div class="absolute top-4 left-4 right-4 flex items-center justify-between gap-2">
                    <span class="px-3.5 py-1 rounded-full text-xs font-bold shadow-xs <%= award.founder? ? 'bg-amber-500 text-slate-950' : 'bg-brand-blue text-white' %>">
                      <%= award.recipient_label %>
                    </span>
                    <% if award.award_year.present? %>
                      <span class="px-3 py-1 rounded-full text-xs font-bold bg-white/95 text-slate-900 shadow-xs">
                        <%= award.award_year %>
                      </span>
                    <% end %>
                  </div>
                  <div class="absolute bottom-3 right-3 px-3 py-1 rounded-full bg-black/65 text-white text-[11px] font-medium backdrop-blur-xs">
                    Click to enlarge
                  </div>
                </a>
              <% end %>

              <div class="p-8 flex-1 flex flex-col justify-between">
                <div>
                  <div class="flex flex-wrap items-center gap-2 text-xs font-semibold text-brand-red uppercase tracking-wider mb-2">
                    <span><%= award.category.presence || award.recipient_label %></span>
                    <% if award.awarded_on.present? %>
                      <span class="text-slate-300">&bull;</span>
                      <span class="text-slate-500"><%= award.awarded_on.strftime("%B %d, %Y") %></span>
                    <% end %>
                  </div>

                  <h2 class="font-heading text-2xl font-bold text-brand-gray-900 mb-3"><%= award.title %></h2>

                  <div class="space-y-1.5 text-sm text-slate-600 mb-5 bg-slate-50 rounded-2xl p-4 border border-slate-100">
                    <div><strong class="text-slate-800">Recipient:</strong> <%= award.recipient_name %></div>
                    <div><strong class="text-slate-800">Awarded By:</strong> <%= award.issuing_organization %></div>
                    <% if award.location.present? %>
                      <div><strong class="text-slate-800">Location:</strong> <%= award.location %></div>
                    <% end %>
                  </div>

                  <% if award.description.present? %>
                    <p class="text-slate-600 text-sm leading-relaxed"><%= award.description %></p>
                  <% end %>
                </div>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="bg-white rounded-3xl border border-slate-200/80 shadow-soft text-center py-20 px-6 max-w-xl mx-auto">
          <h3 class="font-heading text-xl font-bold text-slate-900 mb-2">No awards listed in this category yet</h3>
          <p class="text-slate-500 text-sm mb-6">Check back soon or view all recognitions earned by NewPage Integrity Travels &amp; Tours.</p>
          <%= link_to "View All Awards", awards_path, class: "px-6 py-2.5 rounded-full bg-brand-blue text-white text-sm font-semibold hover:bg-brand-blue-dark transition-colors" %>
        </div>
      <% end %>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-brand-blue-dark text-white text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-3xl font-bold mb-4">Work With an Award-Winning Travel &amp; Consulting Partner</h2>
      <p class="text-slate-300 mb-8">Experience the professionalism, integrity, and excellence recognized by industry leaders across Nigeria.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <%= link_to "Explore Our Services", services_path, class: "px-8 py-3.5 rounded-full bg-brand-red hover:bg-brand-red-light text-white font-semibold transition-colors" %>
        <%= link_to "Contact Us Today", contact_path, class: "px-8 py-3.5 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold transition-colors" %>
      </div>
    </div>
  </section>

  <!-- Lightbox Modal -->
  <div data-lightbox-target="modal" data-action="click->lightbox#close" class="hidden fixed inset-0 z-50 bg-black/90 flex items-center justify-center p-4">
    <div class="max-w-5xl w-full text-center" onclick="event.stopPropagation()">
      <button type="button" data-action="click->lightbox#close" class="mb-4 ml-auto block text-white/80 hover:text-white text-sm font-semibold cursor-pointer">Close ✕</button>
      <img data-lightbox-target="image" src="" alt="" class="max-h-[80vh] mx-auto rounded-xl shadow-2xl">
      <p data-lightbox-target="caption" class="text-white/90 text-sm mt-4"></p>
    </div>
  </div>
</div>
