<% category_meta = {
  nil => {
    eyebrow: "Full-Spectrum Consulting",
    title: "Our Professional Services",
    subtitle: "From international flights and high-approval visa consulting to foreign university admissions and CAC corporate registration — delivered with integrity."
  },
  "travel" => {
    eyebrow: "Travel & Tours Division",
    title: "Travel & Tours Services",
    subtitle: "Flight ticketing across all global airlines, curated holiday packages, hotel reservations, airport shuttles, and travel health insurance."
  },
  "visa" => {
    eyebrow: "Immigration & Visa Consulting",
    title: "Visa Assistance & Residency",
    subtitle: "Expert tourist, business, student, work, and residency visa guidance with thorough document verification and interview preparation."
  },
  "study_abroad" => {
    eyebrow: "International Education",
    title: "Study Abroad & Admissions",
    subtitle: "End-to-end university placement, SOP coaching, scholarship guidance, and student visa support for the UK, Canada, USA, Australia & Europe."
  },
  "cac" => {
    eyebrow: "Corporate Affairs Consulting",
    title: "CAC & Business Registration",
    subtitle: "Fast, compliant Business Name, Limited Liability (LTD), NGO, Church, Annual Returns, TIN, Tax Clearance, and SCUML registrations."
  }
} %>
<% current_meta = category_meta[@active_category] || category_meta[nil] %>

<% service_fallbacks = {
  "travel" => "https://images.unsplash.com/photo-1488085061387-422e29b40080?q=80&w=1200&auto=format&fit=crop",
  "visa" => "https://images.unsplash.com/photo-1544717305-2782549b5136?q=80&w=1200&auto=format&fit=crop",
  "study_abroad" => "https://images.unsplash.com/photo-1523050854058-8df90110c9f1?q=80&w=1200&auto=format&fit=crop",
  "cac" => "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?q=80&w=1200&auto=format&fit=crop"
} %>

<% crumbs = [["Home", root_path], ["Services", @active_category.present? ? services_path : nil]] %>
<% crumbs << [@active_category.humanize, nil] if @active_category.present? %>

<%= render layout: "shared/page_header", locals: {
  title: current_meta[:title],
  subtitle: current_meta[:subtitle],
  eyebrow: current_meta[:eyebrow],
  bg_image: cms_image_url(@page&.hero_image, "https://images.unsplash.com/photo-1521791136064-7986c2920216?q=80&w=2069&auto=format&fit=crop"),
  breadcrumbs: crumbs
} do %>
  <div class="flex flex-col sm:flex-row gap-3.5 justify-center">
    <%= link_to "Book Free Consultation", contact_path, class: "px-7 py-3.5 rounded-full bg-brand-red hover:bg-brand-red-light text-white font-semibold text-sm shadow-lg shadow-brand-red/30 hover:-translate-y-0.5 transition-all" %>
    <a href="<%= whatsapp_link('Hello NewPage Integrity Travels, I would like to inquire about your services.') %>" target="_blank" rel="noopener noreferrer" class="px-7 py-3.5 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold text-sm backdrop-blur-xs hover:-translate-y-0.5 transition-all">
      Chat With a Consultant
    </a>
  </div>
<% end %>

<!-- Sticky Category Filter Bar -->
<section class="py-5 bg-white/95 backdrop-blur-md border-b border-slate-200/80 sticky top-20 z-30 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap gap-2.5 justify-center items-center">
      <% [
        { key: nil, label: "All Services", count: @total_count },
        { key: "travel", label: "Travel & Tours", count: @category_counts["travel"].to_i },
        { key: "visa", label: "Visa Assistance", count: @category_counts["visa"].to_i },
        { key: "study_abroad", label: "Study Abroad", count: @category_counts["study_abroad"].to_i },
        { key: "cac", label: "CAC & Corporate", count: @category_counts["cac"].to_i }
      ].each do |tab| %>
        <% active = @active_category == tab[:key] %>
        <%= link_to(tab[:key] ? services_path(category: tab[:key]) : services_path,
            class: "inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold transition-all #{active ? 'bg-brand-blue text-white shadow-md' : 'bg-slate-100 text-slate-700 hover:bg-slate-200/80 hover:text-brand-blue'}") do %>
          <span><%= tab[:label] %></span>
          <span class="text-xs px-2 py-0.5 rounded-full <%= active ? 'bg-white/20 text-white' : 'bg-white text-slate-500' %>"><%= tab[:count] %></span>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<!-- Services Grid -->
<section class="py-20 bg-brand-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <% if @services.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% @services.each do |service| %>
          <article class="bg-white rounded-3xl shadow-soft border border-slate-100 overflow-hidden group hover:-translate-y-1.5 hover:shadow-hover transition-all duration-300 flex flex-col">
            <div class="relative h-56 overflow-hidden bg-brand-blue-dark">
              <% if service.hero_image.attached? %>
                <%= image_tag service.hero_image, alt: service.title, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" %>
              <% else %>
                <img src="<%= service_fallbacks[service.category.to_s] || service_fallbacks['travel'] %>" alt="<%= service.title %>" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
              <% end %>
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/15 to-transparent"></div>

              <div class="absolute top-4 left-4 right-4 flex items-center justify-between gap-2">
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-white/95 text-brand-blue shadow-xs">
                  <%= service.category.humanize %>
                </span>
                <% if service.featured? %>
                  <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-brand-red text-white shadow-xs">
                    Popular
                  </span>
                <% end %>
              </div>
            </div>

            <div class="p-7 flex-1 flex flex-col justify-between">
              <div>
                <h2 class="font-heading font-bold text-xl text-brand-gray-900 mb-2.5 group-hover:text-brand-blue transition-colors">
                  <%= link_to service.title, service_path(slug: service.slug) %>
                </h2>
                <p class="text-slate-600 text-sm leading-relaxed mb-5 line-clamp-3">
                  <%= service.short_description.presence || strip_tags(service.description.to_s).truncate(130) %>
                </p>

                <% if service.benefits.present? %>
                  <% preview_benefits = service.benefits.split("\n").map(&:strip).reject(&:blank?).first(2) %>
                  <% if preview_benefits.any? %>
                    <ul class="space-y-1.5 mb-6">
                      <% preview_benefits.each do |benefit| %>
                        <li class="flex items-start gap-2 text-xs text-slate-600">
                          <span class="text-emerald-600 font-bold mt-0.5">✓</span>
                          <span class="line-clamp-1"><%= benefit %></span>
                        </li>
                      <% end %>
                    </ul>
                  <% end %>
                <% end %>
              </div>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-3">
                <%= link_to service_path(slug: service.slug), class: "inline-flex items-center text-brand-blue font-semibold text-sm hover:text-brand-red transition-colors" do %>
                  View Full Details
                  <svg class="w-4 h-4 ml-1.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                <% end %>

                <a href="<%= whatsapp_link("Hello NewPage Integrity, I am interested in your #{service.title} service.") %>" target="_blank" rel="noopener noreferrer" class="px-3.5 py-1.5 rounded-full bg-emerald-50 hover:bg-emerald-600 text-emerald-700 hover:text-white text-xs font-semibold transition-colors">
                  WhatsApp
                </a>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="bg-white rounded-3xl border border-slate-200/80 shadow-soft text-center py-20 px-6 max-w-xl mx-auto">
        <div class="w-16 h-16 rounded-2xl bg-brand-blue/10 text-brand-blue flex items-center justify-center mx-auto mb-5">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
        </div>
        <h3 class="font-heading text-xl font-bold text-slate-900 mb-2">No services found in this category yet</h3>
        <p class="text-slate-500 text-sm mb-6">Explore our full catalog or contact our team for a custom request.</p>
        <div class="flex flex-wrap justify-center gap-3">
          <%= link_to "View All Services", services_path, class: "px-6 py-2.5 rounded-full bg-brand-blue text-white text-sm font-semibold hover:bg-brand-blue-dark transition-colors" %>
          <%= link_to "Contact Us", contact_path, class: "px-6 py-2.5 rounded-full border border-slate-300 text-slate-700 text-sm font-semibold hover:border-brand-blue transition-colors" %>
        </div>
      </div>
    <% end %>
  </div>
</section>

<!-- How We Work Process Strip -->
<section class="py-20 bg-white border-t border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="text-brand-red font-semibold text-sm uppercase tracking-wider">Simple &amp; Transparent</span>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-brand-gray-900 mt-2">How Our Process Works</h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <% [
        { step: "01", title: "Free Consultation", desc: "Tell us your travel, visa, study abroad, or corporate registration goal." },
        { step: "02", title: "Document Review", desc: "Our consultants provide a clear checklist and verify every requirement." },
        { step: "03", title: "Submission & Filing", desc: "We handle booking, embassy applications, admissions, or CAC filings accurately." },
        { step: "04", title: "Approval & Support", desc: "Receive your documents, tickets, or certificates with ongoing post-service care." }
      ].each do |item| %>
        <div class="bg-brand-gray-50 rounded-2xl p-7 border border-slate-100">
          <div class="w-11 h-11 rounded-xl bg-brand-blue text-white font-heading font-bold flex items-center justify-center mb-5 shadow-sm">
            <%= item[:step] %>
          </div>
          <h3 class="font-heading font-bold text-lg text-brand-gray-900 mb-2"><%= item[:title] %></h3>
          <p class="text-slate-600 text-sm leading-relaxed"><%= item[:desc] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<!-- Bottom CTA Banner -->
<section class="py-16 bg-brand-blue-dark text-white">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="font-heading text-3xl md:text-4xl font-bold mb-4">Not Sure Which Service Fits Your Goal?</h2>
    <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto mb-8">
      Speak directly with a NewPage Integrity consultant for tailored advice on visas, admissions, flights, or CAC registration.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <%= link_to "Book a Consultation", contact_path, class: "px-8 py-4 rounded-full bg-brand-red hover:bg-brand-red-light text-white font-semibold shadow-lg transition-all" %>
      <a href="<%= whatsapp_link('Hello NewPage Integrity Travels, I need help choosing the right service.') %>" target="_blank" rel="noopener noreferrer" class="px-8 py-4 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold shadow-lg transition-all">
        Chat on WhatsApp
      </a>
    </div>
  </div>
</section>
