<%# Unified Executive Page Header Partial
  Locals:
    title:       (String, required) Main H1 headline
    subtitle:    (String, optional) Supporting lead paragraph
    eyebrow:     (String, optional) Pill badge label above title
    bg_image:    (String, optional) Subtle background photo URL
    breadcrumbs: (Array<[String, String|nil]>, optional) e.g. [["Home", root_path], ["About", nil]]
    align:       (Symbol, optional) :center (default) or :left
    compact:     (Boolean, optional) tighter vertical padding for legal/detail views
  Block (optional): Rendered below subtitle (CTAs, search form, metadata badges)
%>
<% align = local_assigns.fetch(:align, :center).to_sym %>
<% compact = local_assigns.fetch(:compact, false) %>
<% centered = align == :center %>
<% padding_classes = compact ? "py-14 lg:py-20" : "py-18 lg:py-24" %>

<section class="relative overflow-hidden hero-animated-gradient text-white <%= padding_classes %>">
  <div class="absolute inset-0 z-0 pointer-events-none">
    <% if local_assigns[:bg_image].present? %>
      <img src="<%= bg_image %>" alt="" aria-hidden="true" class="w-full h-full object-cover opacity-20 mix-blend-luminosity">
    <% end %>
    <div class="absolute inset-0 hero-animated-gradient opacity-85"></div>
    <div class="absolute inset-0 hero-grid-overlay"></div>
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-brand-red/25 rounded-full blur-3xl hero-orb-slow"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-brand-blue-light/25 rounded-full blur-3xl hero-orb-reverse"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <% if local_assigns[:breadcrumbs].present? %>
      <nav class="flex flex-wrap items-center <%= centered ? 'justify-center' : 'justify-start' %> gap-2 text-xs font-medium text-slate-300 mb-6" aria-label="Breadcrumb">
        <% breadcrumbs.each_with_index do |(label, path), idx| %>
          <% if idx > 0 %>
            <span class="text-slate-400" aria-hidden="true">/</span>
          <% end %>
          <% if path.present? %>
            <%= link_to label, path, class: "hover:text-white transition-colors" %>
          <% else %>
            <span class="text-white font-semibold"><%= label %></span>
          <% end %>
        <% end %>
      </nav>
    <% end %>

    <div class="<%= centered ? 'text-center max-w-3xl mx-auto' : 'text-left max-w-4xl' %>">
      <% if local_assigns[:eyebrow].present? %>
        <span class="inline-flex items-center gap-2 py-1.5 px-4 rounded-full bg-white/10 border border-white/15 text-xs font-semibold uppercase tracking-wider text-blue-100 mb-5 backdrop-blur-sm">
          <span class="w-2 h-2 rounded-full bg-brand-red-light"></span>
          <%= eyebrow %>
        </span>
      <% end %>

      <h1 class="font-heading text-3xl sm:text-5xl <%= compact ? 'lg:text-5xl' : 'lg:text-6xl' %> font-extrabold text-white leading-tight tracking-tight <%= local_assigns[:subtitle].present? || block_given? ? 'mb-5' : '' %>">
        <%= title %>
      </h1>

      <% if local_assigns[:subtitle].present? %>
        <p class="text-base sm:text-lg lg:text-xl text-slate-300 leading-relaxed <%= centered ? 'mx-auto max-w-2xl' : 'max-w-3xl' %> <%= block_given? ? 'mb-8' : '' %>">
          <%= subtitle %>
        </p>
      <% end %>

      <% if block_given? %>
        <div class="<%= centered ? 'flex flex-col items-center' : '' %>">
          <%= yield %>
        </div>
      <% end %>
    </div>
  </div>
</section>
