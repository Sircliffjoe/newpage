<footer class="bg-brand-gray-900 text-white pt-16 pb-8 border-t border-brand-gray-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <!-- Brand & About -->
      <div>
        <div class="flex items-center gap-2 mb-6">
          <div class="w-10 h-10 bg-brand-blue rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <span class="font-heading font-bold text-xl tracking-tight">NEWPAGE <span class="text-brand-red">INTEGRITY</span></span>
        </div>
        <p class="text-gray-400 text-sm leading-relaxed mb-6">
          Your trusted partner for seamless travel experiences, visa assistance, international education, and corporate registrations in Nigeria and beyond.
        </p>
        <div class="flex space-x-4 text-sm">
          <% if site_setting("facebook_url").present? %>
            <a href="<%= site_setting("facebook_url") %>" target="_blank" class="text-gray-400 hover:text-white transition-colors">Facebook</a>
          <% end %>
          <% if site_setting("instagram_url").present? %>
            <a href="<%= site_setting("instagram_url") %>" target="_blank" class="text-gray-400 hover:text-brand-red-light transition-colors">Instagram</a>
          <% end %>
          <% if site_setting("linkedin_url").present? %>
            <a href="<%= site_setting("linkedin_url") %>" target="_blank" class="text-gray-400 hover:text-brand-blue-light transition-colors">LinkedIn</a>
          <% end %>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-heading font-semibold text-lg mb-6">Quick Links</h3>
        <ul class="space-y-3 text-sm">
          <li><%= link_to "About Us", about_path, class: "text-gray-400 hover:text-white transition-colors" %></li>
          <li><%= link_to "Testimonials", testimonials_path, class: "text-gray-400 hover:text-white transition-colors" %></li>
          <li><%= link_to "Photo Gallery", gallery_path, class: "text-gray-400 hover:text-white transition-colors" %></li>
          <li><%= link_to "Latest News & Visa Updates", blog_path, class: "text-gray-400 hover:text-white transition-colors" %></li>
          <li><%= link_to "Frequently Asked Questions", faqs_path, class: "text-gray-400 hover:text-white transition-colors" %></li>
          <li><%= link_to "Search Website", search_path, class: "text-gray-400 hover:text-white transition-colors" %></li>
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3 class="font-heading font-semibold text-lg mb-6">Our Services</h3>
        <ul class="space-y-3 text-sm">
          <li><%= link_to "Travel & Tours", services_path(category: "travel"), class: "text-gray-400 hover:text-white transition-colors" %></li>
          <li><%= link_to "Visa Assistance", visa_information_path, class: "text-gray-400 hover:text-white transition-colors" %></li>
          <li><%= link_to "Study Abroad", study_abroad_path, class: "text-gray-400 hover:text-white transition-colors" %></li>
          <li><%= link_to "CAC Registration", cac_services_path, class: "text-gray-400 hover:text-white transition-colors" %></li>
          <li><%= link_to "Destinations", destinations_path, class: "text-gray-400 hover:text-white transition-colors" %></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-heading font-semibold text-lg mb-6">Contact Us</h3>
        <ul class="space-y-4 text-gray-400 text-sm">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-brand-red flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <span><%= site_setting("address", "No 4 Airport Road opp. Kosini junction, Warri, Delta State, Nigeria.") %></span>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-brand-red flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            <a href="tel:<%= site_setting('phone', '+2348038656409').gsub(/\s+/, '') %>" class="hover:text-white transition-colors"><%= site_setting("phone", "+234 803 865 6409") %></a>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-brand-red flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <a href="mailto:<%= site_setting('email', 'newpageintegritytravels@gmail.com') %>" class="hover:text-white transition-colors"><%= site_setting("email", "newpageintegritytravels@gmail.com") %></a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-brand-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-gray-500 text-sm">
        &copy; <%= Time.current.year %> NewPage Integrity Travels &amp; Tours Limited. All rights reserved.
      </p>
      <div class="flex space-x-5 text-sm text-gray-500">
        <%= link_to "Privacy Policy", privacy_policy_path, class: "hover:text-white transition-colors" %>
        <%= link_to "Terms of Service", terms_of_service_path, class: "hover:text-white transition-colors" %>
        <%= link_to "Admin CMS", admin_root_path, class: "hover:text-white transition-colors" %>
      </div>
    </div>
  </div>
</footer>
